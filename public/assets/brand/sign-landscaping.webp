   يُحمَّل بعد main.css — الهيدر/الفوتر/الأساس/الصفحات الداخلية
   ╚══════════════════════════════════════════════════════╝ */

/* ════════════════════════════════════════════════════════
   RUKN ELTATAWER — Ultimate Homepage Redesign 2026
   Enterprise + Modern SaaS + Premium Service Business
   ════════════════════════════════════════════════════════ */

:root{
  /* Brand palette */
  --navy:#0A1F4E;
  --navy2:#1A3A6B;
  --blue:#2980D4;
  --turq:#2E9DF7;
  --aqua:#4FA8FF;
  --gold:#C9A227;
  --gold2:#F0CE73;
  --footer:#124C9C;
  --success:#18C96A;
  --wa:#25D366;

  /* Neutrals */
  --bg:#F4F8FD;
  --text:#1C2E44;
  --text2:#3A5068;
  --border:#E2EAF5;
  --white:#FFFFFF;
  --muted:#6B8099;

  /* Radii */
  --r-s:16px;
  --r-m:24px;
  --r-l:32px;

  /* Shadows */
  --sh-s:0 4px 16px rgba(10,31,78,.06);
  --sh-m:0 12px 32px rgba(10,31,78,.10);
  --sh-l:0 24px 60px rgba(10,31,78,.16);
  --sh-glow:0 16px 48px rgba(46,157,247,.28);

  /* Layout */
  --max:1400px;
  --pad:120px;

  --grad:linear-gradient(135deg,var(--navy) 0%,var(--navy2) 45%,var(--turq) 100%);
  --grad-cta:linear-gradient(135deg,var(--blue),var(--turq));
}

*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:100px}
body{
  font-family:'Tajawal','Cairo',sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.7;
  overflow-x:hidden;
  font-size:18px;
}
a{text-decoration:none;color:inherit}
ul{list-style:none}
img{max-width:100%;display:block}
section{position:relative}

h1,h2,h3,h4{font-family:'Cairo','Tajawal',sans-serif;line-height:1.25;color:var(--navy)}
h1{font-size:clamp(36px,5vw,56px);font-weight:900}
h2{font-size:clamp(28px,3.6vw,42px);font-weight:800}
h3{font-size:clamp(22px,2.4vw,28px);font-weight:700}

.wrap{max-width:var(--max);margin:0 auto;padding:0 24px}
.sec{padding:var(--pad) 0}
@media(max-width:1024px){:root{--pad:80px}}
@media(max-width:640px){:root{--pad:60px};body{font-size:16px}}

/* Section headers */
.shead{text-align:center;max-width:760px;margin:0 auto 60px}
.shead .tag{
  display:inline-block;font-weight:800;font-size:14px;letter-spacing:.5px;
  color:var(--turq);background:rgba(46,157,247,.10);
  padding:8px 18px;border-radius:999px;margin-bottom:18px;
}
.shead h2 span{background:var(--grad-cta);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.shead p{color:var(--text2);font-size:18px;margin-top:14px}

/* Buttons */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  font-family:'Cairo',sans-serif;font-weight:700;font-size:16px;
  padding:15px 28px;border-radius:14px;border:none;cursor:pointer;
  transition:transform .25s ease,box-shadow .25s ease,filter .25s ease;
  white-space:nowrap;
}
.btn:hover{transform:translateY(-3px)}
.btn-wa{background:var(--wa);color:#fff;box-shadow:0 10px 24px rgba(37,211,102,.32)}
.btn-call{background:var(--turq);color:#fff;box-shadow:0 10px 24px rgba(46,157,247,.32)}
.btn-quote{background:linear-gradient(120deg,var(--gold),var(--gold2));color:var(--navy);box-shadow:0 10px 24px rgba(201,162,39,.34)}
.btn-ghost{background:rgba(255,255,255,.12);color:#fff;border:1.5px solid rgba(255,255,255,.35);backdrop-filter:blur(8px)}
.btn-soft{background:var(--white);color:var(--navy);box-shadow:var(--sh-s);border:1.5px solid var(--border)}
.btn-soft:hover{border-color:var(--turq);color:var(--turq)}

/* ═══════════════ Reveal animations ═══════════════ */
.rv{opacity:0;transform:translateY(36px);transition:opacity .7s cubic-bezier(.2,.7,.3,1),transform .7s cubic-bezier(.2,.7,.3,1)}
.rv-l{opacity:0;transform:translateX(40px);transition:opacity .7s cubic-bezier(.2,.7,.3,1),transform .7s cubic-bezier(.2,.7,.3,1)}
.rv.on,.rv-l.on{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.rv,.rv-l{opacity:1;transform:none;transition:none}}

/* ═══════════════ Loader ═══════════════ */
#loader{position:fixed;inset:0;z-index:9999;background:var(--navy);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:22px;transition:opacity .6s ease,visibility .6s ease}
#loader.out{opacity:0;visibility:hidden}
.ld-logo{font-family:'Cairo';font-weight:900;font-size:30px;color:#fff;letter-spacing:1px}
.ld-logo span{color:var(--aqua)}
.ld-bar{width:180px;height:4px;border-radius:9px;background:rgba(255,255,255,.15);overflow:hidden}
.ld-bar i{display:block;height:100%;width:40%;border-radius:9px;background:var(--grad-cta);animation:ld 1.1s infinite}
@keyframes ld{0%{transform:translateX(-120%)}100%{transform:translateX(380%)}}

/* ═══════════════ Header ═══════════════ */
header{position:fixed;top:0;inset-inline:0;z-index:1000;height:80px;display:flex;align-items:center;transition:all .35s ease}
header.scrolled{height:70px;background:rgba(255,255,255,.78);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:0 8px 30px rgba(10,31,78,.10);border-bottom:1px solid rgba(226,234,245,.7)}
.nav{display:flex;align-items:center;justify-content:space-between;width:100%}
.logo{display:flex;align-items:center;gap:12px;font-family:'Cairo';font-weight:900;font-size:24px;color:#fff;transition:color .3s}
header.scrolled .logo{color:var(--navy)}
.logo .mark{width:46px;height:46px;border-radius:13px;background:var(--grad-cta);display:grid;place-items:center;color:#fff;font-size:22px;box-shadow:var(--sh-glow)}
.logo b{color:var(--aqua)}
header.scrolled .logo b{color:var(--turq)}
.menu{display:flex;align-items:center;gap:8px}
.menu a{font-family:'Cairo';font-weight:600;font-size:16px;color:rgba(255,255,255,.9);padding:9px 16px;border-radius:10px;transition:all .25s}
header.scrolled .menu a{color:var(--text2)}
.menu a:hover{color:#fff;background:rgba(255,255,255,.14)}
header.scrolled .menu a:hover{color:var(--turq);background:rgba(46,157,247,.10)}
.nav-cta{display:flex;align-items:center;gap:12px}
.ham{display:none;width:46px;height:46px;border-radius:12px;border:none;background:rgba(255,255,255,.15);cursor:pointer;flex-direction:column;gap:5px;align-items:center;justify-content:center}
header.scrolled .ham{background:rgba(10,31,78,.07)}
.ham span{width:22px;height:2.4px;background:#fff;border-radius:3px;transition:.3s}
header.scrolled .ham span{background:var(--navy)}

/* Mobile menu */
.mob{position:fixed;inset:0;z-index:1100;background:var(--navy);transform:translateX(100%);transition:transform .4s cubic-bezier(.4,0,.2,1);padding:90px 28px 28px;display:flex;flex-direction:column;gap:6px}
.mob.open{transform:translateX(0)}
.mob a{font-family:'Cairo';font-weight:700;font-size:20px;color:#fff;padding:16px 14px;border-bottom:1px solid rgba(255,255,255,.08)}
.mob .btn{margin-top:18px}
.mob-close{position:absolute;top:24px;inset-inline-start:24px;width:46px;height:46px;border-radius:12px;border:none;background:rgba(255,255,255,.12);color:#fff;font-size:22px;cursor:pointer}


/* ═══════════════ Footer ═══════════════ */
footer{background:var(--footer);color:rgba(255,255,255,.82);padding:70px 0 0}
.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px;padding-bottom:48px}
.fcol h4{color:#fff;font-size:18px;margin-bottom:20px}
.fcol p{font-size:14.5px;margin-bottom:18px}
.fcol .flogo{display:flex;align-items:center;gap:11px;font-family:'Cairo';font-weight:900;font-size:22px;color:#fff;margin-bottom:16px}
.fcol .flogo .mark{width:42px;height:42px;border-radius:12px;background:rgba(255,255,255,.16);display:grid;place-items:center;color:#fff;font-size:20px}
.fcol .flogo b{color:var(--aqua)}
.fcontact{display:grid;gap:10px;font-size:14px;margin-bottom:18px}
.fcontact a{display:flex;align-items:center;gap:10px}
.fcontact i{color:var(--aqua);width:18px;text-align:center}
.fcol ul li{margin-bottom:11px}
.fcol ul a{font-size:14.5px;display:inline-flex;align-items:center;gap:8px;transition:.2s}
.fcol ul a:hover{color:var(--aqua);padding-inline-start:4px}
.fcol ul a i{font-size:11px;color:var(--aqua)}
.fsocial{display:flex;flex-wrap:wrap;gap:10px}
.fsocial a{width:42px;height:42px;border-radius:11px;background:rgba(255,255,255,.12);display:grid;place-items:center;color:#fff;font-size:16px;transition:.25s}
.fsocial a:hover{background:#fff;color:var(--navy);transform:translateY(-3px)}

/* Footer map strip */
.fmap{background:rgba(0,0,0,.16);margin-top:12px}
.fmap-addr-row{max-width:var(--max);margin:0 auto;padding:22px 24px 8px;display:flex;align-items:center;gap:14px}
.fmap-addr-row i{font-size:22px;color:var(--aqua);flex:none}
.fmap-addr-row b{display:block;font-family:'Cairo';font-weight:800;font-size:16px;color:#fff}
.fmap-addr-row span{font-size:13.5px;color:rgba(255,255,255,.72)}
.fmap-frame{width:100%;height:230px;border:0;display:block;filter:grayscale(.1) contrast(1.02)}

.fbottom{border-top:1px solid rgba(255,255,255,.12);padding:22px 0;text-align:center;font-size:13.5px}

/* ═══════════════ Floating call + WhatsApp stack ═══════════════ */
.fab-stack{position:fixed;bottom:26px;inset-inline-start:26px;z-index:850;display:flex;flex-direction:column;gap:14px;opacity:0;visibility:hidden;transform:translateY(14px);transition:.3s}
.fab-stack.show{opacity:1;visibility:visible;transform:none}
.fab-btn{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:23px;box-shadow:0 12px 30px rgba(10,31,78,.35);position:relative}
.fab-call{background:linear-gradient(135deg,var(--blue),var(--turq))}
.fab-wa{background:var(--wa);box-shadow:0 12px 30px rgba(37,211,102,.4)}
.fab-wa::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--wa);animation:ring 2s infinite;z-index:-1}
@keyframes ring{0%{transform:scale(1);opacity:.6}100%{transform:scale(1.7);opacity:0}}

/* ═══════════════ Responsive ═══════════════ */
@media(max-width:1024px){
  .hero .wrap{grid-template-columns:1fr;gap:40px}
  .why{grid-template-columns:1fr;gap:30px}
  .why-time{position:static}
  .areas{grid-template-columns:1fr;gap:30px}
  .services-grid,.proj-grid,.blog-grid{grid-template-columns:1fr 1fr}
  .trustbar .inner{grid-template-columns:repeat(3,1fr)}
  .stats-grid{grid-template-columns:repeat(2,1fr)}
  .rcard{flex:0 0 calc(50% - 16px)}
}
@media(max-width:768px){
  .menu,.nav-cta .btn{display:none}
  .ham{display:flex}
}
@media(max-width:640px){
  .services-grid,.proj-grid,.blog-grid,.why-cards,.area-cards,.fgrid{grid-template-columns:1fr}
  .trustbar .inner{grid-template-columns:1fr 1fr}
  .stats-grid{grid-template-columns:1fr 1fr}
  .rcard{flex:0 0 calc(100% - 16px)}
  .dash-mini,.dash-stats{grid-template-columns:1fr 1fr}
  .ba-stage{height:300px}
}


/* ════════════════════════════════════════════════════════
   RUKN ELTATAWER — Inner Pages Extension (same design language)
   ════════════════════════════════════════════════════════ */

/* ─── Inner page hero (smaller than homepage hero) ─── */
.phero{min-height:auto;padding:150px 0 70px;background:var(--grad);overflow:hidden;display:block}
.phero::before{content:"";position:absolute;inset:0;background:
  radial-gradient(900px 500px at 85% 0%,rgba(79,168,255,.22),transparent 60%),
  radial-gradient(700px 500px at 10% 100%,rgba(41,128,212,.25),transparent 60%)}
.phero .wrap{position:relative;z-index:2}
.crumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:14px;font-weight:600;color:rgba(255,255,255,.68);margin-bottom:18px}
.crumb a{color:rgba(255,255,255,.68);transition:.2s}
.crumb a:hover{color:var(--aqua)}
.crumb i{font-size:10px;color:rgba(255,255,255,.4)}
.crumb span{color:#fff}
.phero h1{color:#fff;max-width:820px}
.phero h1 em{font-style:normal;background:linear-gradient(120deg,var(--aqua),var(--gold));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.phero .psub{color:rgba(255,255,255,.86);font-size:clamp(15px,1.3vw,19px);margin-top:16px;max-width:700px}
.phero .hero-proof{margin-top:26px}
.phero-meta{display:flex;flex-wrap:wrap;gap:28px;margin-top:30px}
.phero-meta div b{display:block;font-family:'Cairo';font-weight:900;font-size:26px;color:#fff}
.phero-meta div small{color:rgba(255,255,255,.72);font-size:13px}

/* Light variant hero for content pages (about/faq/contact/legal) */
.phero.compact{padding:145px 0 60px}

/* ─── Header icon buttons (search, menu, language) ─── */
.icon-btn{width:46px;height:46px;border-radius:13px;border:none;background:rgba(255,255,255,.16);color:#fff;display:grid;place-items:center;font-size:17px;cursor:pointer;transition:.25s;flex:none}
.icon-btn:hover{background:rgba(255,255,255,.28);transform:translateY(-2px)}
header.scrolled .icon-btn{background:rgba(10,31,78,.08);color:var(--navy)}
header.scrolled .icon-btn:hover{background:var(--grad-cta);color:#fff}
.icon-btn.lang-btn{font-family:'Cairo';font-weight:800;font-size:13px;gap:4px}
.icon-btn.lang-btn img{width:20px;height:20px;border-radius:50%;object-fit:cover}

.lang-item{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 14px;border-bottom:1px solid rgba(255,255,255,.08)}
.lang-item .ll{display:flex;align-items:center;gap:10px;font-family:'Cairo';font-weight:700;color:#fff;font-size:16px}
.lang-item select{font-family:'Tajawal';font-weight:700;font-size:14px;background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.2);border-radius:10px;padding:8px 12px}

/* ─── Filter / toolbar (category & city index pages) ─── */
.toolbar{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;background:#fff;border:1px solid var(--border);border-radius:var(--r-m);box-shadow:var(--sh-s);padding:18px 22px;margin-bottom:34px}
.toolbar .results{font-weight:700;color:var(--text2);font-size:14.5px}
.toolbar .results b{color:var(--navy)}
.search-box{position:relative;flex:1;min-width:220px;max-width:340px}
.search-box input{width:100%;font-family:'Tajawal';font-size:15px;padding:12px 44px 12px 16px;border-radius:12px;border:1.5px solid var(--border);background:var(--bg);transition:.25s}
.search-box input:focus{outline:none;border-color:var(--turq);box-shadow:0 0 0 4px rgba(46,157,247,.12)}
.search-box i{position:absolute;top:50%;inset-inline-start:14px;transform:translateY(-50%);color:var(--muted)}

/* ─── Category pills ─── */
.pillbar{display:flex;flex-wrap:wrap;gap:10px}
.pillbar button,.pillbar a{font-family:'Cairo';font-weight:700;font-size:14px;padding:9px 18px;border-radius:999px;border:1.5px solid var(--border);background:#fff;color:var(--text2);cursor:pointer;transition:.25s}
.pillbar button.active,.pillbar a.active,.pillbar button:hover,.pillbar a:hover{background:var(--grad-cta);color:#fff;border-color:transparent}

/* ─── Breadcrumb strip under hero (for pages needing extra spacing) ─── */
.strip{background:#fff;border-bottom:1px solid var(--border);padding:16px 0}

/* ─── Category / service category cards ─── */
.cat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.catcard{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);padding:26px;text-align:center;transition:transform .3s ease,box-shadow .3s ease,border-color .3s}
.catcard:hover{transform:translateY(-8px);box-shadow:var(--sh-glow);border-color:transparent}
.catcard .cic{width:64px;height:64px;border-radius:16px;background:var(--grad-cta);color:#fff;display:grid;place-items:center;font-size:26px;margin:0 auto 16px;box-shadow:var(--sh-glow)}
.catcard h3{font-size:18px;margin-bottom:6px}
.catcard p{color:var(--text2);font-size:13.5px;margin-bottom:12px}
.catcard .ccount{display:inline-block;font-size:12.5px;font-weight:800;color:var(--turq);background:rgba(46,157,247,.10);padding:5px 12px;border-radius:999px}

/* ─── City cards (index) ─── */
.city-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.citycard{position:relative;border-radius:var(--r-m);overflow:hidden;height:220px;display:flex;align-items:flex-end;padding:22px;color:#fff;background:var(--grad);transition:.35s;box-shadow:var(--sh-s)}
.citycard::before{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(7,18,38,.88),rgba(7,18,38,.15) 60%);z-index:1}
.citycard::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:32px 32px;mask-image:radial-gradient(circle at 70% 20%,#000,transparent 75%)}
.citycard:hover{transform:translateY(-6px);box-shadow:var(--sh-l)}
.citycard .cc-in{position:relative;z-index:2;width:100%}
.citycard h3{color:#fff;font-size:22px;margin-bottom:4px}
.citycard small{color:rgba(255,255,255,.78);display:flex;align-items:center;gap:6px}
.citycard .ccbadge{position:absolute;top:16px;inset-inline-end:16px;z-index:2;background:rgba(255,255,255,.16);backdrop-filter:blur(6px);color:#fff;font-size:12px;font-weight:800;padding:5px 12px;border-radius:999px}

/* ─── Pagination ─── */
.pager{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:44px}
.pager a,.pager span{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;font-family:'Cairo';font-weight:700;font-size:14.5px;background:#fff;border:1.5px solid var(--border);color:var(--text2);transition:.25s}
.pager a:hover{border-color:var(--turq);color:var(--turq)}
.pager .cur{background:var(--grad-cta);color:#fff;border-color:transparent}
.pager .next{width:auto;padding:0 18px;gap:8px;display:inline-flex}

/* ─── Blog cards ─── */
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.bcard{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);overflow:hidden;transition:.35s}
.bcard:hover{transform:translateY(-8px);box-shadow:var(--sh-l)}
.bcard .bimg{height:190px;background:var(--grad);position:relative;display:grid;place-items:center;color:#fff;font-size:34px}
.bcard .bimg .bcat{position:absolute;top:14px;inset-inline-start:14px;background:rgba(255,255,255,.92);color:var(--navy);font-size:11.5px;font-weight:800;padding:5px 12px;border-radius:999px}
.bcard .bbody{padding:22px}
.bcard .bmeta{display:flex;gap:14px;color:var(--muted);font-size:12.5px;margin-bottom:10px}
.bcard .bmeta span{display:inline-flex;align-items:center;gap:5px}
.bcard h3{font-size:18.5px;margin-bottom:8px;line-height:1.4}
.bcard p{color:var(--text2);font-size:14px;margin-bottom:14px}
.bcard .bread{display:inline-flex;align-items:center;gap:8px;font-family:'Cairo';font-weight:700;color:var(--turq);font-size:14.5px}
.bcard .bread i{transition:transform .25s}
.bcard:hover .bread i{transform:translateX(-5px)}
.bcard.featured{grid-column:span 2}
.bcard.featured .bimg{height:280px}
@media(max-width:1024px){.bcard.featured{grid-column:span 1}}

/* ─── Article / long-form content typography ─── */
.article-layout{display:grid;grid-template-columns:2.1fr 1fr;gap:50px;align-items:start}
.article-body{background:#fff;border:1px solid var(--border);border-radius:var(--r-l);padding:44px;box-shadow:var(--sh-s)}
.prose{color:var(--text);font-size:17px;line-height:1.9}
.prose h2{margin:34px 0 16px;font-size:26px}
.prose h3{margin:26px 0 12px;font-size:21px}
.prose p{margin-bottom:18px;color:var(--text2)}
.prose ul,.prose ol{margin:0 0 18px;padding-inline-start:22px;display:grid;gap:8px;color:var(--text2)}
.prose li{font-size:16.5px}
.prose blockquote{border-inline-start:4px solid var(--turq);background:var(--bg);padding:18px 22px;border-radius:12px;margin:22px 0;color:var(--navy);font-weight:600}
.prose img,.prose .imgph{width:100%;border-radius:var(--r-s);margin:22px 0;height:280px;background:var(--grad);display:grid;place-items:center;color:#fff;font-size:30px}
.prose table{width:100%;border-collapse:collapse;margin:20px 0}
.prose table th{background:var(--navy);color:#fff;padding:12px 16px;font-family:'Cairo';font-size:14.5px;text-align:start}
.prose table td{padding:12px 16px;border-bottom:1px solid var(--border);font-size:14.5px;color:var(--text2)}
.article-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:30px;padding-top:24px;border-top:1px solid var(--border)}
.article-tags a{font-size:13px;font-weight:700;color:var(--text2);background:var(--bg);border:1px solid var(--border);padding:6px 14px;border-radius:999px;transition:.2s}
.article-tags a:hover{color:var(--turq);border-color:var(--turq)}
.author-box{display:flex;gap:16px;align-items:center;background:var(--bg);border-radius:var(--r-s);padding:20px;margin-top:30px}
.author-box .aav{width:58px;height:58px;border-radius:50%;background:var(--grad-cta);color:#fff;display:grid;place-items:center;font-family:'Cairo';font-weight:900;font-size:20px;flex:none}
.author-box b{font-family:'Cairo';display:block;font-size:16px}
.author-box small{color:var(--text2);font-size:13.5px}

/* Sidebar widgets */
.side-w{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);padding:24px;margin-bottom:22px}
.side-w h4{font-family:'Cairo';font-weight:800;font-size:16px;margin-bottom:16px;padding-bottom:12px;border-bottom:2px solid var(--bg)}
.side-w.cta{background:var(--grad);color:#fff;text-align:center}
.side-w.cta h4{color:#fff;border-color:rgba(255,255,255,.2)}
.side-w.cta p{color:rgba(255,255,255,.82);font-size:14px;margin-bottom:16px}
.side-w .toc{display:grid;gap:10px}
.side-w .toc a{display:flex;gap:8px;font-size:14px;color:var(--text2);transition:.2s}
.side-w .toc a:hover{color:var(--turq)}
.side-w .toc i{color:var(--turq);font-size:10px;margin-top:6px}
.side-w .rel{display:flex;gap:12px;margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border)}
.side-w .rel:last-child{border:none;margin:0;padding:0}
.side-w .rel .rth{width:60px;height:60px;border-radius:10px;background:var(--grad);flex:none;display:grid;place-items:center;color:#fff}
.side-w .rel b{font-size:13.5px;display:block;line-height:1.4}
.side-w .rel small{color:var(--muted);font-size:12px}

/* ─── Forms (contact / booking) ─── */
.form-card{background:#fff;border:1px solid var(--border);border-radius:var(--r-l);box-shadow:var(--sh-m);padding:38px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.fld{display:flex;flex-direction:column;gap:8px}
.fld.full{grid-column:1/-1}
.fld label{font-family:'Cairo';font-weight:700;font-size:14.5px;color:var(--navy)}
.fld input,.fld select,.fld textarea{font-family:'Tajawal';font-size:15.5px;padding:14px 16px;border-radius:13px;border:1.5px solid var(--border);background:var(--bg);transition:.25s;width:100%}
.fld textarea{resize:vertical;min-height:120px}
.fld input:focus,.fld select:focus,.fld textarea:focus{outline:none;border-color:var(--turq);box-shadow:0 0 0 4px rgba(46,157,247,.12)}
.form-note{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13px;margin-top:14px}

.contact-layout{display:grid;grid-template-columns:1fr 1.3fr;gap:40px;align-items:start}
.cinfo-card{background:var(--grad);color:#fff;border-radius:var(--r-l);padding:34px;position:relative;overflow:hidden}
.cinfo-card::before{content:"";position:absolute;inset:0;background:radial-gradient(500px 300px at 80% 0,rgba(79,168,255,.28),transparent 60%)}
.cinfo-card .inner{position:relative;z-index:2}
.cinfo-item{display:flex;gap:14px;align-items:flex-start;margin-bottom:22px}
.cinfo-item i{width:46px;height:46px;border-radius:13px;background:rgba(255,255,255,.14);display:grid;place-items:center;font-size:18px;flex:none}
.cinfo-item b{display:block;font-family:'Cairo';font-size:15.5px}
.cinfo-item small{color:rgba(255,255,255,.78);font-size:13.5px}
.map-ph{margin-top:20px;height:220px;border-radius:16px;background:rgba(255,255,255,.08);border:1px dashed rgba(255,255,255,.3);display:grid;place-items:center;color:rgba(255,255,255,.75);font-size:14px;gap:8px}

/* ─── FAQ page extras (category tabs use .faq-cats already; add page-hero counts) ─── */
.faq-cats{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:34px}
.faq-cats button{font-family:'Cairo';font-weight:700;font-size:14.5px;padding:10px 20px;border-radius:999px;border:1.5px solid var(--border);background:#fff;color:var(--text2);cursor:pointer;transition:.25s}
.faq-cats button.active,.faq-cats button:hover{background:var(--grad-cta);color:#fff;border-color:transparent}
.faq-list{max-width:860px;margin:0 auto;display:grid;gap:14px}
.faq-item{background:#fff;border:1px solid var(--border);border-radius:var(--r-s);overflow:hidden;transition:.3s}
.faq-item.hide{display:none}
.faq-q{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 24px;cursor:pointer;font-family:'Cairo';font-weight:700;font-size:16px;color:var(--navy)}
.faq-q i{color:var(--turq);transition:.3s;flex:none}
.faq-item.faq-open .faq-q i{transform:rotate(180deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .4s ease}
.faq-a p{padding:0 24px 22px;color:var(--text2);font-size:15px}

/* ─── Offers / discounts ─── */
.offer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.offer{position:relative;background:#fff;border:1px solid var(--border);border-radius:var(--r-m);overflow:hidden;transition:.35s}
.offer:hover{transform:translateY(-8px);box-shadow:var(--sh-l)}
.offer-top{background:var(--grad);color:#fff;padding:26px 24px;position:relative;overflow:hidden}
.offer-top::before{content:"";position:absolute;inset:0;background:radial-gradient(400px 200px at 90% 0,rgba(79,168,255,.3),transparent 60%)}
.offer-badge{position:absolute;top:16px;inset-inline-start:16px;background:linear-gradient(120deg,var(--gold),var(--gold2));color:var(--navy);font-family:'Cairo';font-weight:900;font-size:13px;padding:6px 14px;border-radius:999px;z-index:2}
.offer-top .off-pct{position:relative;z-index:2;font-family:'Cairo';font-weight:900;font-size:40px;line-height:1}
.offer-top .off-pct small{font-size:16px;font-weight:700}
.offer-top h3{position:relative;z-index:2;color:#fff;font-size:19px;margin-top:8px}
.offer-body{padding:22px 24px}
.offer-body p{color:var(--text2);font-size:14px;margin-bottom:14px}
.offer-exp{display:flex;align-items:center;gap:8px;color:#c0392b;font-weight:700;font-size:13.5px;margin-bottom:16px}
.offer .btn{width:100%}

/* ─── 404 page ─── */
.err-wrap{min-height:80vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:160px 0 90px;background:var(--grad);position:relative;overflow:hidden}
.err-wrap::before{content:"";position:absolute;inset:0;background:radial-gradient(900px 500px at 85% 10%,rgba(79,168,255,.22),transparent 60%),radial-gradient(700px 500px at 10% 90%,rgba(41,128,212,.25),transparent 60%)}
.err-wrap .wrap{position:relative;z-index:2}
.err-num{font-family:'Cairo';font-weight:900;font-size:clamp(90px,16vw,180px);line-height:1;background:linear-gradient(120deg,#fff,var(--aqua));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.err-wrap h2{color:#fff;margin:10px 0 14px}
.err-wrap p{color:rgba(255,255,255,.82);max-width:520px;margin:0 auto 30px}
.err-actions{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-bottom:36px}
.err-links{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
.err-links a{color:rgba(255,255,255,.85);font-size:14px;font-weight:600;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.2);padding:8px 16px;border-radius:999px;transition:.2s}
.err-links a:hover{background:rgba(255,255,255,.2)}

/* ─── Legal / prose pages (privacy, terms) ─── */
.legal-updated{display:inline-flex;align-items:center;gap:8px;font-size:13.5px;color:var(--text2);background:var(--bg);border:1px solid var(--border);padding:8px 16px;border-radius:999px;margin-bottom:24px}
.legal-toc{display:grid;gap:8px;margin-bottom:10px}
.legal-toc a{display:flex;align-items:center;gap:10px;font-size:14.5px;color:var(--text2);padding:8px 4px;transition:.2s}
.legal-toc a:hover{color:var(--turq)}
.legal-toc b{color:var(--turq);font-family:'Cairo'}

/* ─── About page ─── */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px}
.abcard{background:#fff;border:1px solid var(--border);border-radius:var(--r-l);padding:34px;transition:.3s}
.abcard:hover{box-shadow:var(--sh-m)}
.abcard .aic{width:58px;height:58px;border-radius:15px;background:var(--grad-cta);color:#fff;display:grid;place-items:center;font-size:24px;margin-bottom:18px;box-shadow:var(--sh-glow)}
.timeline-h{display:grid;gap:0;position:relative;padding-inline-start:30px}
.timeline-h::before{content:"";position:absolute;top:6px;bottom:6px;inset-inline-start:9px;width:2px;background:var(--border)}
.th-item{position:relative;padding-bottom:32px}
.th-item::before{content:"";position:absolute;inset-inline-start:-30px;top:2px;width:20px;height:20px;border-radius:50%;background:var(--grad-cta);border:4px solid var(--bg);box-shadow:0 0 0 2px var(--turq)}
.th-item b{font-family:'Cairo';color:var(--turq);font-size:14px}
.th-item h3{font-size:19px;margin:4px 0 6px}
.th-item p{color:var(--text2);font-size:14.5px}

/* ─── Reviews page extras ─── */
.rev-summary{display:grid;grid-template-columns:.7fr 1.3fr;gap:30px;background:#fff;border:1px solid var(--border);border-radius:var(--r-l);box-shadow:var(--sh-s);padding:34px;margin-bottom:40px;align-items:center}
.rev-score{text-align:center;border-inline-end:1px solid var(--border);padding-inline-end:24px}
.rev-score .big{font-family:'Cairo';font-weight:900;font-size:56px;color:var(--navy);line-height:1}
.rev-score .stars{color:var(--gold);font-size:20px;margin:8px 0}
.rev-score small{color:var(--muted);font-size:13.5px}
.rev-bars{display:grid;gap:10px}
.rbar-row{display:flex;align-items:center;gap:10px;font-size:13.5px;color:var(--text2)}
.rbar-row .track{flex:1;height:9px;border-radius:99px;background:var(--bg);overflow:hidden}
.rbar-row .track i{display:block;height:100%;background:var(--grad-cta);border-radius:99px}
.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.rvcard2{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);padding:26px;transition:.3s}
.rvcard2:hover{box-shadow:var(--sh-m);transform:translateY(-4px)}

/* ─── Gallery / portfolio lightbox-style grid ─── */
.gal-grid{columns:4 260px;column-gap:20px}
.gal-item{break-inside:avoid;margin-bottom:20px;border-radius:var(--r-s);overflow:hidden;position:relative;background:var(--grad);cursor:pointer}
.gal-item img,.gal-ph{width:100%;display:block}
.gal-ph{height:220px;display:grid;place-items:center;color:#fff;font-size:28px}
.gal-item .gtag{position:absolute;bottom:12px;inset-inline-start:12px;background:rgba(7,18,38,.72);color:#fff;font-size:12.5px;font-weight:700;padding:6px 12px;border-radius:999px;backdrop-filter:blur(4px)}

/* ─── Responsive ─── */
@media(max-width:1024px){
  .cat-grid,.city-grid{grid-template-columns:repeat(2,1fr)}
  .blog-grid,.offer-grid,.review-grid{grid-template-columns:repeat(2,1fr)}
  .article-layout{grid-template-columns:1fr}
  .contact-layout{grid-template-columns:1fr}
  .form-grid{grid-template-columns:1fr}
  .about-grid{grid-template-columns:1fr}
  .rev-summary{grid-template-columns:1fr}
  .rev-score{border-inline-end:none;border-bottom:1px solid var(--border);padding-bottom:20px}
  .gal-grid{columns:2 220px}
}
@media(max-width:640px){
  .cat-grid,.city-grid,.blog-grid,.offer-grid,.review-grid{grid-template-columns:1fr}
  .bcard.featured{grid-column:span 1}
  .article-body{padding:26px}
  .form-card{padding:24px}
  .gal-grid{columns:1}
  .err-num{font-size:100px}
}




/* ════════════════════════════════════════════════════════
   WORDPRESS INTEGRATION LAYER — Rukn v3 (Kayan)
   ════════════════════════════════════════════════════════ */

/* تحييد ستايلات الهيدر القديمة في main.css */
header::before{content:none!important;display:none!important}
header{background:transparent;padding:0;flex-wrap:nowrap}
header .wrap{display:flex;align-items:center}

/* قوائم منسدلة (Sub-menus) بنفس لغة التصميم الجديد */
.menu .has-sub{position:relative}
.menu .has-sub>a>i.car{font-size:11px;margin-inline-start:6px;opacity:.75}
.menu .has-sub::after{content:"";position:absolute;top:100%;height:16px;width:100%;inset-inline-start:0}
.menu .sub{position:absolute;top:calc(100% + 14px);inset-inline-start:0;min-width:240px;background:#fff;border:1px solid var(--border);border-radius:16px;box-shadow:var(--sh-m);padding:10px;opacity:0;visibility:hidden;transform:translateY(10px);transition:.25s;display:flex;flex-direction:column;gap:2px;z-index:60}
.menu .has-sub:hover>.sub{opacity:1;visibility:visible;transform:none}
.menu .sub a{color:var(--text2)!important;font-size:15px;font-weight:600;padding:10px 14px;border-radius:10px;display:block;background:none!important}
.menu .sub a:hover{background:rgba(46,157,247,.10)!important;color:var(--turq)!important}
.mob .sub-mob a{font-size:16px;font-weight:600;padding-inline-start:30px;opacity:.85}

/* لوجو صورة من لوحة التحكم */
.logo img,.flogo img{max-height:52px;width:auto;display:block}

/* fallback لو الجافاسكريبت متعطلة */
#loader{animation:ld-safety .4s 5s forwards}
@keyframes ld-safety{to{opacity:0;visibility:hidden}}

/* ════════════════════════════════════════════════════════
   LEGACY VARIABLES REMAP — الودجت القديمة تاخد الباليتة الجديدة فوراً
   ════════════════════════════════════════════════════════ */
:root{
  --uicolor:#2980D4;--second-color:#2E9DF7;--uicolor-hover:#0A1F4E;
  --primary-text:#0A1F4E;--secondarytext:#3A5068;--Text-color:#1C2E44;
  --headings-color:#0A1F4E;--backicon:#2980D4;--tp-common-black:#2E9DF7;
  --tp-common-text:#0A1F4E;--whatsapp:#25D366;--diver:#E2EAF5;
  --miniradius:16px;--largeradius:24px;
  --font-family:'Tajawal','Cairo',sans-serif;--f-logo:'Cairo','Tajawal',sans-serif;
  --f-number:'Cairo','Tajawal',sans-serif;--font-familyen:'Cairo';
  --secbutton:#2E9DF7;--backcolor:#0A1F4E;--intro-co:#F4F8FD;
  --background:#F4F8FD;--uitrans:rgba(46,157,247,.06);
  --success-color:#18C96A;--positive:#18C96A;
  --box-shadow-defult:0 4px 16px rgba(10,31,78,.06);
  --box-shadow-hover:0 12px 32px rgba(10,31,78,.10);
  --faq-shadow:0 4px 16px rgba(10,31,78,.06);
  --al-shadow:0 8px 30px rgba(10,31,78,.10);
}

/* تحييد كلاسات setup.js القديمة على الهيدر الجديد */
header.fixedintro,header.hidemenu{transform:none;background:transparent}
header.fixedintro.scrolled,header.hidemenu.scrolled{background:rgba(255,255,255,.78)}
/* زر البحث القديم جوه الهيدر الجديد ياخد شكل icon-btn */
.nav-cta .--open--searching{background-image:none!important;box-shadow:none!important;animation:none!important}

/* ═══════════════ إصلاحات الموبايل: اللوجو والبحث والقائمة ═══════════════ */
/* تقييد حجم اللوجو حتى لا يركب على أزرار الهيدر */
.logo img{max-height:46px;max-width:min(48vw,220px);width:auto;object-fit:contain}
@media (max-width:400px){.logo img{max-width:42vw}}

/* زر البحث داخل قائمة الموبايل */
.mob-search{display:flex;align-items:center;gap:10px;width:100%;text-align:start;font-family:'Cairo',sans-serif;font-weight:700;font-size:17px;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);border-radius:12px;padding:13px 16px;cursor:pointer;transition:.25s}
.mob-search i{color:var(--aqua)}
.mob-search:hover{background:rgba(255,255,255,.14)}

/* إخفاء زر البحث من الهيدر في الموبايل (موجود داخل القائمة) */
@media (max-width:1024px){.nav-cta .--open--searching{display:none}}

/* ╔══════════════════════════════════════════════════════════════╗
   RUKN v3 — طبقة صفحات الأرشيف (التصنيفات/المدن/الوسوم)
   ╚══════════════════════════════════════════════════════════════╝ */

/* رأس الأرشيف — الهيرو الكحلي المضغوط */
.--primary--intro--pages{
  position:relative;background:var(--grad);padding:145px 0 55px;overflow:hidden;
}
.--primary--intro--pages::before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(600px 350px at 80% 0,rgba(79,168,255,.25),transparent 60%);
}
.--primary--intro--pages .container{position:relative;z-index:2}
.--primary--intro--pages h1,.--container--category--info h1{
  font-family:'Cairo',sans-serif!important;font-weight:900;color:#fff!important;
  font-size:clamp(26px,4vw,38px);line-height:1.45;margin:0 0 12px;
}
.--archive--be-content,.--archive--be-content *{
  color:rgba(255,255,255,.85)!important;font-family:'Tajawal',sans-serif;
  font-size:16px;line-height:1.85;max-width:760px;
}
.--archive--be-content a.readmore--category-item{
  color:var(--aqua)!important;font-weight:700;
}
.-intro--page--category .--inner--intro--video,.-intro--page--category iframe{
  border-radius:var(--r-m);overflow:hidden;box-shadow:var(--sh-m);
}

/* شبكة كروت المقالات في الأرشيف */
.-archivePage-Posts-Grid .-ScrollerCenter{
  display:grid;grid-template-columns:repeat(3,1fr);gap:24px;
}
@media (max-width:1024px){.-archivePage-Posts-Grid .-ScrollerCenter{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.-archivePage-Posts-Grid .-ScrollerCenter{grid-template-columns:1fr}}

/* كارت المقال — نفس ستايل كروت المدونة v3 */
.-Post-box-single-item{
  background:#fff;border:1px solid var(--border);border-radius:var(--r-m);
  overflow:hidden;box-shadow:var(--sh-s);transition:transform .3s,box-shadow .3s;
  height:100%;display:flex;flex-direction:column;
}
.-Post-box-single-item:hover{transform:translateY(-8px);box-shadow:var(--sh-m)}
.-Post-box-item-Thumb,.--thumb--blog-image--{border-radius:0!important;overflow:hidden}
.-Post-box-item-Thumb img,.--thumb--blog-image-- img{transition:transform .5s}
.-Post-box-single-item:hover .-Post-box-item-Thumb img{transform:scale(1.06)}
.-P-content{padding:20px 22px;flex:1}
.-P-content .posts_title,.-P-content .posts_title a,.-P-content h2,.-P-content h3{
  font-family:'Cairo',sans-serif!important;font-weight:800;color:var(--navy)!important;
  font-size:17.5px;line-height:1.6;transition:color .25s;
}
.-Post-box-single-item:hover .posts_title a{color:var(--turq)!important}
.-P-content p{font-family:'Tajawal',sans-serif;color:var(--text2);font-size:14.5px;line-height:1.8}

/* زرار تحميل المزيد */
.LoadMorePostsBTN{
  font-family:'Cairo',sans-serif!important;font-weight:800;
  background:rgba(46,157,247,.10)!important;color:var(--turq)!important;
  border:1.5px solid rgba(46,157,247,.3)!important;border-radius:999px!important;
  padding:12px 30px!important;transition:.25s!important;cursor:pointer;
}
.LoadMorePostsBTN:hover{background:var(--grad-cta)!important;color:#fff!important;border-color:transparent!important}

/* حالة عدم وجود نتائج */
.--empty-attchment-area{
  font-family:'Cairo',sans-serif;color:var(--text2);
  background:#fff;border:1px dashed var(--border);border-radius:var(--r-m);padding:50px 20px;
}

/* ╔══════════════════════════════════════════════════════════════╗
   RUKN v3 — طبقة كروت سابقة الأعمال وخطط الأسعار (الأجزاء المشتركة)
   ╚══════════════════════════════════════════════════════════════╝ */

/* ═══ كارت سابقة الأعمال (#Works-box) ═══ */
.--single--work-post-box{
  background:#fff;border:1px solid var(--border);border-radius:var(--r-m);
  overflow:hidden;box-shadow:var(--sh-s);transition:transform .3s,box-shadow .3s;
}
.--single--work-post-box:hover{transform:translateY(-8px);box-shadow:var(--sh-m)}
.--single--thumb-image,.--minithumb-image{overflow:hidden}
.--single--thumb-image img{transition:transform .5s}
.--single--work-post-box:hover .--single--thumb-image img{transform:scale(1.05)}
.--single--work--info{padding:18px 20px}
.--single--work--info h2,.--single--work--info h3,
.--single--work--info h2 a,.--single--work--info h3 a{
  font-family:'Cairo',sans-serif!important;font-weight:800;color:var(--navy)!important;
  font-size:17px;line-height:1.6;transition:color .25s;
}
.--single--work-post-box:hover .--single--work--info a{color:var(--turq)!important}
.--single--work-Active--Stars{color:var(--gold)}
.--single--work--Stars{color:#d7dee9}

/* ═══ كارت خطة الأسعار (#PriceBoxes) ═══ */
.-PriceBox-v1-box{
  background:#fff;border:1px solid var(--border);border-radius:var(--r-m);
  box-shadow:var(--sh-s);transition:transform .3s,box-shadow .3s,border-color .3s;overflow:hidden;
}
.-PriceBox-v1-box:hover{transform:translateY(-8px);box-shadow:var(--sh-m)}
.-PriceBox-v1-box.-ActivePlane{
  border:2px solid var(--gold);box-shadow:0 18px 44px rgba(201,162,39,.22);
}
.--icon-price-in-,.--prices-space-icon i{
  color:var(--turq);
}
.-P-Plane--Content h2,.-P-Plane--Content h3,.-Planes-Info-sowh-In{
  font-family:'Cairo',sans-serif!important;font-weight:800;color:var(--navy);
}
.-Price-Selary{font-family:'Cairo',sans-serif!important;font-weight:900;color:var(--navy);font-size:30px}
.-discout-value{background:linear-gradient(135deg,var(--gold),#ffce6b);color:#3a2600;border-radius:999px;font-family:'Cairo',sans-serif;font-weight:800;padding:4px 14px}
.-Price-Items-List li{font-family:'Tajawal',sans-serif;color:var(--text2)}
.-Price-Items-List .-Disabled-Features{opacity:.45;text-decoration:line-through}
.-Plane-Button-v1,.-Twesters-Link{
  background:var(--grad-cta)!important;color:#fff!important;border-radius:999px!important;
  font-family:'Cairo',sans-serif!important;font-weight:800;border:none!important;
  transition:transform .25s,box-shadow .25s!important;
}
.-Plane-Button-v1:hover,.-Twesters-Link:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(46,157,247,.4)}
.-ActivePlane .-Plane-Button-v1{background:linear-gradient(135deg,var(--gold),#d98b15)!important;box-shadow:0 10px 26px rgba(201,162,39,.4)}
