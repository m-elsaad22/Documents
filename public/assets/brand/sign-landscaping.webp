ion: relative;}.first--image-left--after-intro img {border-radius: var(--miniradius);box-shadow: var(--faq-shadow);}.first--image-left--after-intro {position: relative;display: block;max-width: max-content;}.--image-after-intro--- {position: absolute;right: 0;bottom: -100px;border-bottom-left-radius: 60px;overflow: hidden;}.--after-experince-banar-- {position: absolute;top: 30px;right: 0px;display: flex;align-items: center;padding: 25px;border-radius: var(--largeradius) var(--largeradius) 0 var(--largeradius);z-index: 2;background: var(--tp-common-black);color: var(--tp-common-text);}.--after-experince-banar--:before {position: absolute;top: 8px;left: 8px;bottom: 8px;right: 8px;border: 2px dashed var(--tp-common-text);border-radius: inherit;content: "";opacity: 0.7;}span.--years-number-- {font-size: 20px;font-weight: 500;max-width: 80px;line-height: 1.4;text-align: start;}span.--years-experince-- {font-size: 55px;font-weight: 800;margin-inline-end: 13px;font-family: var(--f-number);}.-after__intro-contain--lists {display: flex;flex-wrap: wrap;}.after--intro-point--image- {border-bottom: 1px solid #0000001c;padding-bottom: 20px;margin-bottom: 20px;}.-defult-intro-title-URL>.--Parent-URL-BTN>a>span {margin-inline-end: 9px;}.-defult-intro-title-URL>.--Parent-URL-BTN>a:hover:after {transform: scaleY(1);transform-origin: top;}@keyframes pulsex {0% {transform: translateX(0) }100% {transform: translateX(-80px) }}.--back-ground-after-into- {position: absolute;left: 0;top: 0;opacity: 0.05;}.--in--left--button--after-intro > a > i {--el-w: 58px;width: var(--el-w);height: var(--el-w);display: flex;justify-content: center;align-items: center;color: var(--whatsapp);font-size: 28px;font-weight: 800;margin-inline-end: 15px;background: rgb(255, 255, 255);border-radius: 50%;border: 2px solid var(--whatsapp);transition: all 180ms ease 0s;font-weight: 500;padding-top: 3px;padding-inline-start: 3px;}.--in--left--button--after-intro > a:before {content: "";display: block;position: absolute;border: 2px solid var(--whatsapp);inset: -20px;border-radius: 50%;animation: 1.5s linear infinite animate;opacity: 0;--yyj: 58px;width: var(--yyj);height: var(--yyj);top: -2px;right: -2px;}.--in--left--button--after-intro:hover > a > i {background: var(--whatsapp);color: #fff;}.after-title {font-size: 16px;line-height: 1.5;color: var(--primary-text);font-weight: 500;margin-bottom: 10px;}.-defult-intro-title-URL .-defult-widgets-title--URLArea-v1 {display: flex;flex-direction: row;}.-defult-intro-title-URL .main-ket-button_1 {margin-inline-end: 10px;}.--in--left--button-title {display: flex;transition: 350ms ease;border-radius: 50px;position: relative;align-items: center;margin-inline-start: 15px;background-color: var(--whatsapp);background-size: 100% auto;}.--in--left--button-title: before {display:block;position: absolute;border: 2px solid var(--whatsapp);border-radius: 50% }.--in--left--button--after-intro>a: before,.--in--left--button-title:before {content:"";inset: -20px;animation: 1.5s linear infinite animate;opacity: 0;--yyj: 58px;width: var(--yyj);height: var(--yyj);top: -2px;right: -2px }.-Intro-slider-URLArea,.-Intro-slider-URLArea a {display: flex;align-items: center;position: relative;align-content: center }--in--left--button-title>a>i {--el-w: 58px;width: var(--el-w);height: var(--el-w);display: flex;justify-content: center;align-items: center;color: var(--whatsapp);font-size: 28px;margin-inline-end:15px;background: #fff;border-radius: 50%;border: 2px solid var(--whatsapp);transition: 180ms;font-weight: 500;padding-top: 3px;padding-inline-start:3px}.--in--left--button-title: hover>a>i {background:var(--whatsapp);color: #fff }.-Intro-slider-URLArea a p {font-size: 24px;font-family: var(--f-number);font-weight: 600 }.-defult-intro-title-URL .--in--left--button-title a i {--el-w: 60px;width: var(--el-w);height: var(--el-w);display: flex;justify-content: center;align-items: center;color: var(--whatsapp);font-size: 24px;margin-inline-end: 15px;background: #fff;border-radius: 50%;border: 2px solid var(--whatsapp);transition: 180ms;font-weight: 500;padding-top: 3px;padding-inline-start: 3px;background-color: #fff;position: relative;}.--in--left--button-title > a > p {color: #fff;font-size: 19px;line-height: 1.5;font-weight: 600;margin-inline-end: 18px;}.--in--left--button-title > a {display: flex;align-items: center;}@keyframes pulse514 {0% {box-shadow: 0 0 0 0 #429f58;}70% {box-shadow: 0 0 0 10px rgb(218 103 68 / 0%);}100% {box-shadow: 0 0 0 0 rgb(218 103 68 / 0%);}}.-YC-WidgetType-after__intro .btn-ket_1 {margin-inline-end: 20px;margin-bottom: 0;}.-YC-WidgetType-after__intro .btn-ket_2 {margin-bottom: 0;}/* ==== RUKN v3 SERVICE FINDER - rukn_finder.css (ودجت جديدة) ====
   باحث الخدمات الذكي — الخطوتين + صندوق النتيجة الكحلي */
/* Smart service finder */
.finder-sec{padding-top:90px}
.finder{background:#fff;border:1px solid var(--border);border-radius:var(--r-l);box-shadow:var(--sh-m);padding:26px;display:grid;grid-template-columns:1fr 1fr auto;gap:18px;align-items:end}
.finder-step label{display:flex;align-items:center;gap:8px;font-family:'Cairo';font-weight:700;font-size:15px;color:var(--navy);margin-bottom:10px}
.finder-step .snum{width:26px;height:26px;border-radius:50%;background:var(--grad-cta);color:#fff;display:grid;place-items:center;font-size:13px;font-weight:800}
.sel{position:relative}
.sel i{position:absolute;top:50%;inset-inline-start:14px;transform:translateY(-50%);color:var(--turq);font-size:15px;pointer-events:none}
.sel select{width:100%;font-family:'Tajawal',sans-serif;font-weight:600;font-size:16px;color:var(--text);background:var(--bg);border:1.5px solid var(--border);border-radius:14px;padding:14px 44px 14px 16px;cursor:pointer;appearance:none;-webkit-appearance:none;transition:.25s}
.sel select:focus{outline:none;border-color:var(--turq);box-shadow:0 0 0 4px rgba(46,157,247,.12)}
.sel::after{content:"\f078";font-family:"Font Awesome 6 Free";font-weight:900;position:absolute;top:50%;inset-inline-end:14px;transform:translateY(-50%);color:var(--muted);font-size:12px;pointer-events:none}
.finder-go .btn{width:100%}
.finder-result{margin-top:22px;background:var(--grad);color:#fff;border-radius:var(--r-m);padding:24px;display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr;gap:18px;align-items:center;box-shadow:var(--sh-l);animation:fadeUp .5s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.fr-lead b{font-family:'Cairo';font-weight:900;font-size:19px;display:block}
.fr-lead small{color:rgba(255,255,255,.82)}
.fr-stat{text-align:center;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.16);border-radius:14px;padding:14px 8px}
.fr-stat i{color:var(--aqua);font-size:18px;margin-bottom:6px;display:block}
.fr-stat b{display:block;font-family:'Cairo';font-weight:800;font-size:16px}
.fr-stat small{color:rgba(255,255,255,.78);font-size:12px}
.fr-ok{color:#bdfff0!important}

/* ==== WordPress adjustments ==== */
.-YC-WidgetType-rukn_finder{padding:var(--pad) 0 90px}
.-YC-WidgetType-rukn_finder .-YC-Widgets-Inner-Row{padding:0}
.-YC-WidgetType-rukn_finder.-Top-separator-shows__in{background:#fff}

/* زرار الواتساب أسفل النتيجة */
.finder-wa-wrap{text-align:center;margin-top:18px}

/* الريسبونسف */
@media (max-width:1024px){
  .finder{grid-template-columns:1fr}
  .finder-result{grid-template-columns:1fr 1fr}
  .finder-result .fr-lead{grid-column:1/-1}
}
@media (max-width:640px){
  .finder-result{grid-template-columns:1fr}
}
/* ╔══════════════════════════════════════════════════════╗
   RUKN v3 SERVICES GRID — category.css
   كروت الخدمات — يتحمّل تلقائياً عند تفعيل الودجت
   (ستايلات .shead/.tag/.sec المشتركة في rukn-v3.css)
   ╚══════════════════════════════════════════════════════╝ */
/* ═══════════════ Services ═══════════════ */
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.svc{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);padding:30px;transition:transform .3s ease,box-shadow .3s ease,border-color .3s;position:relative;overflow:hidden}
.svc::after{content:"";position:absolute;inset:0;border-radius:inherit;box-shadow:0 0 0 0 rgba(46,157,247,0);transition:.3s;pointer-events:none}
.svc:hover{transform:translateY(-8px);box-shadow:var(--sh-glow);border-color:transparent}
.svc-ic{width:62px;height:62px;border-radius:17px;background:var(--grad-cta);display:grid;place-items:center;color:#fff;font-size:26px;margin-bottom:18px;box-shadow:var(--sh-glow)}
.svc h3{margin-bottom:8px}
.svc .desc{color:var(--text2);font-size:15.5px;margin-bottom:16px}
.svc ul{display:grid;gap:9px;margin-bottom:20px}
.svc li{display:flex;align-items:center;gap:9px;font-size:14.5px;color:var(--text2)}
.svc li i{color:var(--success);font-size:13px}
.svc .svc-cta{display:inline-flex;align-items:center;gap:8px;font-family:'Cairo';font-weight:700;color:var(--turq);font-size:15px}
.svc .svc-cta i{transition:transform .25s}
.svc:hover .svc-cta i{transform:translateX(-5px)}


/* ═══════════════ WordPress adjustments ═══════════════ */
/* حشوة القسم — استبدال حشوة الودجات القديمة بحشوة التصميم الجديد */
.-YC-WidgetType-category{padding:var(--pad) 0}
.-YC-WidgetType-category .-YC-Widgets-Inner-Row{padding:0}

/* الخلفية البيضاء عند تفعيل سويتش "خلفية بيضاء للشريحة" */
.-YC-WidgetType-category.-Top-separator-shows__in{background:#fff}

/* عنوان الكارت كرابط — يورث لون العنوان وبيتحول تركواز عند الهوفر */
.svc h3 a{color:inherit;transition:color .25s}
.svc:hover h3 a{color:var(--turq)}

/* زرار المزيد من الخدمات */
.svc-more-wrap{text-align:center;margin-top:44px}

/* الريسبونسف الخاص بالشبكة (احتياطي — موجود أيضاً في rukn-v3.css) */
@media (max-width:1024px){.services-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.services-grid{grid-template-columns:1fr}}

/* ═══ توافق قالب صفحة "جميع الخدمات" (@models/categories.php) ═══ */
.-YC-Category-all-in{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding:50px 0}
@media (max-width:1024px){.-YC-Category-all-in{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.-YC-Category-all-in{grid-template-columns:1fr}}
.--single--category--boxitem{
  position:relative;background:#fff;border:1px solid var(--border);border-radius:var(--r-m);
  padding:30px 26px;box-shadow:var(--sh-s);transition:transform .3s,box-shadow .3s,border-color .3s;overflow:hidden;
}
.--single--category--boxitem:hover{transform:translateY(-8px);box-shadow:var(--sh-m);border-color:rgba(46,157,247,.35)}
.--single--category--boxitem .--YC-category-widget i,
.--single--category--boxitem .--YC-category-- i{
  width:64px;height:64px;display:grid;place-items:center;border-radius:18px;
  background:var(--grad-cta);color:#fff;font-size:26px;box-shadow:0 10px 24px rgba(46,157,247,.35);margin-bottom:18px;
}
.--single--category--boxitem h2,.--single--category--boxitem h3,
.--single--category--boxitem h2 a,.--single--category--boxitem h3 a{
  font-family:'Cairo',sans-serif!important;font-weight:800;color:var(--navy)!important;
  font-size:19px;line-height:1.55;transition:color .25s;
}
.--single--category--boxitem:hover h2 a,.--single--category--boxitem:hover h3 a{color:var(--turq)!important}
.--single--category--boxitem p{font-family:'Tajawal',sans-serif;color:var(--text2);font-size:14.5px;line-height:1.8}
.--YC-before-back{display:none}
/* ╔══════════════════════════════════════════════════════╗
   RUKN v3 WHY US — benefits.css
   التايم لاين الكحلي اللاصق + شبكة كروت المميزات
   (ستايلات .shead/.tag المشتركة في rukn-v3.css)
   ╚══════════════════════════════════════════════════════╝ */
/* ═══════════════ Why choose ═══════════════ */
.why{display:grid;grid-template-columns:.85fr 1.15fr;gap:50px;align-items:start}
.why-time{position:sticky;top:110px;background:var(--grad);border-radius:var(--r-l);padding:38px;color:#fff;overflow:hidden}
.why-time::before{content:"";position:absolute;inset:0;background:radial-gradient(500px 300px at 80% 0,rgba(79,168,255,.28),transparent 60%)}
.why-time .inner{position:relative;z-index:2}
.why-time h2{color:#fff;font-size:clamp(26px,3vw,38px)}
.why-time p{color:rgba(255,255,255,.82);margin:16px 0 26px}
.tline{display:grid;gap:18px}
.tl{display:flex;gap:14px;align-items:flex-start}
.tl .dot{flex:none;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);display:grid;place-items:center;color:var(--aqua);font-weight:800;font-size:14px}
.tl b{display:block;font-family:'Cairo';font-weight:700;font-size:16px}
.tl small{color:rgba(255,255,255,.74);font-size:13.5px}
.why-cards{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.feat{background:#fff;border:1px solid var(--border);border-radius:var(--r-s);padding:24px;transition:.3s}
.feat:hover{transform:translateY(-6px);box-shadow:var(--sh-m);border-color:rgba(46,157,247,.4)}
.feat .fic{width:54px;height:54px;border-radius:14px;background:rgba(41,128,212,.10);color:var(--blue);display:grid;place-items:center;font-size:23px;margin-bottom:14px}
.feat h3{font-size:19px;margin-bottom:6px}
.feat p{color:var(--text2);font-size:14.5px}

/* ═══════════════ WordPress adjustments ═══════════════ */
/* حشوة القسم — استبدال حشوة الودجات القديمة */
.-YC-WidgetType-benefits{padding:var(--pad) 0}
.-YC-WidgetType-benefits .-YC-Widgets-Inner-Row{padding:0}

/* الخلفية البيضاء (القسم أبيض في التصميم الأصلي — فعّل سويتش الخلفية) */
.-YC-WidgetType-benefits.-Top-separator-shows__in{background:#fff}

/* البطاقة اللاصقة تحسب ارتفاع الهيدر الثابت */
.why-time{top:110px}

/* الريسبونسف الخاص بالقسم */
@media (max-width:1024px){
  .why{grid-template-columns:1fr}
  .why-time{position:relative;top:0}
}
@media (max-width:640px){
  .why-cards{grid-template-columns:1fr}
}
/* ==== RUKN v3 STATS - rukn_stats.css (ودجت جديدة) ====
   الشريط الكحلي المتدرج بالعدادات المتحركة */
/* ═══════════════ Stats (dark) ═══════════════ */
.stats{background:var(--grad);color:#fff;overflow:hidden}
.stats::before{content:"";position:absolute;inset:0;background:radial-gradient(700px 400px at 15% 20%,rgba(79,168,255,.20),transparent 60%),radial-gradient(700px 400px at 85% 80%,rgba(201,162,39,.16),transparent 60%)}
.stats .wrap{position:relative;z-index:2}
.stats .shead h2,.stats .shead p{color:#fff}
.stats .shead .tag{background:rgba(255,255,255,.14);color:#bdfff0}
.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.stat{text-align:center;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:var(--r-m);padding:34px 18px;transition:.3s}
.stat:hover{transform:translateY(-6px);background:rgba(255,255,255,.12)}
.stat i{font-size:30px;color:var(--aqua);margin-bottom:12px}
.stat .num{font-family:'Cairo';font-weight:900;font-size:clamp(34px,4vw,50px);line-height:1;background:linear-gradient(120deg,#fff,var(--aqua));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.stat .lbl{color:rgba(255,255,255,.82);font-weight:600;margin-top:8px}

/* ==== WordPress adjustments ==== */
/* الشريط الكحلي بيغطي القسم بالكامل */
.-YC-WidgetType-rukn_stats{padding:0}
.-YC-WidgetType-rukn_stats .-YC-Widgets-Inner-Row{padding:0}
.rukn-stats-inner{position:relative;background:var(--grad);color:#fff;overflow:hidden;padding:var(--pad) 0}
.rukn-stats-inner::before{content:"";position:absolute;inset:0;background:radial-gradient(700px 400px at 15% 20%,rgba(79,168,255,.20),transparent 60%),radial-gradient(700px 400px at 85% 80%,rgba(201,162,39,.16),transparent 60%)}
.rukn-stats-inner .wrap{position:relative;z-index:2}
.rukn-stats-inner .shead h2,.rukn-stats-inner .shead p{color:#fff}
.rukn-stats-inner .shead .tag{background:rgba(255,255,255,.14);color:#bdfff0}

/* الريسبونسف */
@media (max-width:1024px){.stats-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.stats-grid{grid-template-columns:1fr 1fr;gap:14px}.stat{padding:24px 12px}}
/* ==== RUKN v3 - rukn_certs.css (ودجت جديدة) ====
   كروت الشهادات والتراخيص */
/* Certifications */
.cert-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.cert{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);padding:26px;transition:transform .3s ease,box-shadow .3s ease,border-color .3s;position:relative}
.cert:hover{transform:translateY(-8px);box-shadow:var(--sh-m);border-color:var(--turq)}
.cert-ic{width:58px;height:58px;border-radius:15px;background:rgba(41,128,212,.10);color:var(--blue);display:grid;place-items:center;font-size:24px;margin-bottom:16px}
.cert h3{font-size:19px;margin-bottom:6px}
.cert p{color:var(--text2);font-size:14px;margin-bottom:16px}
.cert .vbadge{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:800;color:var(--success);background:rgba(24,201,106,.10);padding:6px 12px;border-radius:999px;margin-bottom:14px}
.cert .doc{display:flex;align-items:center;justify-content:center;gap:9px;height:84px;border:2px dashed var(--border);border-radius:14px;color:var(--muted);font-size:13.5px;font-weight:600;background:var(--bg);transition:.25s}
.cert:hover .doc{border-color:var(--turq);color:var(--turq)}

/* ==== WordPress adjustments ==== */
.-YC-WidgetType-rukn_certs{padding:var(--pad) 0}
.-YC-WidgetType-rukn_certs .-YC-Widgets-Inner-Row{padding:0}
.-YC-WidgetType-rukn_certs{background:#fff}
.-YC-WidgetType-rukn_certs.-Top-separator-shows__in{background:var(--bg)}

/* منطقة المستند كرابط */
a.doc{text-decoration:none}

/* الريسبونسف */
@media (max-width:1024px){.cert-grid{grid-template-columns:1fr 1fr}}
@media (max-width:640px){.cert-grid{grid-template-columns:1fr}}
/* ==== RUKN v3 REVIEWS - rukn_reviews.css (ودجت جديدة) ====
   سلايدر تقييمات Google الموثقة */
/* ═══════════════ Reviews ═══════════════ */
.reviews{background:#fff}
.rv-slider{overflow:hidden;position:relative}
.rv-track{display:flex;transition:transform .6s cubic-bezier(.4,0,.2,1)}
.rcard{flex:0 0 calc(33.333% - 16px);margin-inline:8px;background:var(--bg);border:1px solid var(--border);border-radius:var(--r-m);padding:28px}
.rcard .gtop{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.gver{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:700;color:var(--text2)}
.gver i{color:#4285F4}
.rstars{color:var(--gold)}
.rcard .txt{color:var(--text);font-size:15.5px;margin-bottom:18px;min-height:90px}
.rclient{display:flex;align-items:center;gap:12px}
.rav{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;color:#fff;font-family:'Cairo';font-weight:800;font-size:18px;background:var(--grad-cta)}
.rclient b{display:block;font-family:'Cairo';font-size:16px}
.rclient small{color:var(--muted);font-size:13px}
.rv-nav{display:flex;justify-content:center;gap:10px;margin-top:28px}
.rv-nav button{width:46px;height:46px;border-radius:50%;border:1.5px solid var(--border);background:#fff;color:var(--navy);font-size:16px;cursor:pointer;transition:.25s}
.rv-nav button:hover{background:var(--grad-cta);color:#fff;border-color:transparent}

/* ==== WordPress adjustments ==== */
.-YC-WidgetType-rukn_reviews{padding:var(--pad) 0}
.-YC-WidgetType-rukn_reviews .-YC-Widgets-Inner-Row{padding:0}

/* القسم أبيض في التصميم الأصلي */
.-YC-WidgetType-rukn_reviews{background:#fff}
.-YC-WidgetType-rukn_reviews.-Top-separator-shows__in{background:var(--bg)}

/* الريسبونسف — عرض الكروت بيتحسب بالجافاسكريبت */
@media (max-width:1024px){.rcard{flex:0 0 calc(50% - 16px)}}
@media (max-width:640px){.rcard{flex:0 0 calc(100% - 16px)}.rcard .txt{min-height:0}}
/* ==== RUKN v3 SERVICE AREAS - city__widget.css ====
   خريطة الإمارات الكحلية + كروت المدن القابلة للفتح
   (ستايلات .shead/.tag المشتركة في rukn-v3.css) */
/* ═══════════════ Service areas ═══════════════ */
.areas{display:grid;grid-template-columns:1fr 1.1fr;gap:46px;align-items:center}
.area-map{background:var(--grad);border-radius:var(--r-l);padding:34px;color:#fff;min-height:420px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;position:relative}
.area-map::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:38px 38px;mask-image:radial-gradient(circle at 50% 50%,#000,transparent 78%)}
.area-map .mp{position:relative;z-index:2;flex:1;display:grid;place-items:center}
.uae-svg{width:100%;max-width:340px}
.uae-svg path{fill:rgba(255,255,255,.10);stroke:var(--aqua);stroke-width:2.5}
.pin{position:absolute;width:14px;height:14px;border-radius:50%;background:var(--aqua);box-shadow:0 0 0 0 rgba(79,168,255,.6);animation:pulse 2s infinite}
.area-map h3{color:#fff;position:relative;z-index:2}
.area-map p{color:rgba(255,255,255,.8);position:relative;z-index:2;font-size:14.5px}
.area-cards{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.acard{background:#fff;border:1px solid var(--border);border-radius:var(--r-s);padding:22px;cursor:pointer;transition:.3s}
.acard:hover{transform:translateY(-6px);box-shadow:var(--sh-m);border-color:var(--turq)}
.acard .ah{display:flex;align-items:center;gap:12px;margin-bottom:6px}
.acard .ah i{width:44px;height:44px;border-radius:12px;background:rgba(46,157,247,.12);color:var(--turq);display:grid;place-items:center;font-size:19px}
.acard b{font-family:'Cairo';font-weight:800;font-size:18px;display:block}
.acard small{color:var(--muted);font-size:13px}
.acard .svcs{max-height:0;overflow:hidden;transition:max-height .4s ease,margin .4s ease;display:flex;flex-wrap:wrap;gap:6px}
.acard.open .svcs{max-height:140px;margin-top:12px}
.acard .svcs span{font-size:12px;background:var(--bg);border:1px solid var(--border);color:var(--text2);padding:4px 10px;border-radius:999px}

/* ==== WordPress adjustments ==== */
/* حشوة القسم */
.-YC-WidgetType-city__widget{padding:var(--pad) 0}
.-YC-WidgetType-city__widget .-YC-Widgets-Inner-Row{padding:0}

/* الخلفية البيضاء عند تفعيل السويتش */
.-YC-WidgetType-city__widget.-Top-separator-shows__in{background:#fff}

/* شارات أسفل الخريطة (احتياطي لو الهيرو مش متحمل في نفس الصفحة) */
.area-map .dash-trust{display:flex;flex-wrap:wrap;gap:8px;position:relative;z-index:2}
.area-map .dt{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:700;color:rgba(255,255,255,.85);background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);padding:7px 12px;border-radius:999px}

/* نبض دبابيس الخريطة (احتياطي لو الهيرو مش في الصفحة) */
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(79,168,255,.55)}70%{box-shadow:0 0 0 14px rgba(79,168,255,0)}100%{box-shadow:0 0 0 0 rgba(79,168,255,0)}}

/* اسم المدينة كرابط */
.acard .acard-link{color:inherit}
.acard .acard-link:hover b{color:var(--turq)}
.acard b{transition:color .25s}

/* كارت "لم تجد مدينتك؟" — الستايل المدمج في التصميم اتحول لكلاس */
.acard-cta{display:grid;place-items:center;text-align:center;background:var(--grad);color:#fff;border:none}

/* الريسبونسف الخاص بالقسم */
@media (max-width:1024px){
  .areas{grid-template-columns:1fr}
}
@media (max-width:640px){
  .area-cards{grid-template-columns:1fr}
}

/* ═══ توافق قالب صفحة "جميع المدن" (@models/cities.php) ═══ */
.--cites-single-box-{
  background:#fff;border:1px solid var(--border);border-radius:var(--r-m);
  padding:26px;box-shadow:var(--sh-s);transition:transform .3s,box-shadow .3s,border-color .3s;
}
.--cites-single-box-:hover{transform:translateY(-8px);box-shadow:var(--sh-m);border-color:rgba(46,157,247,.35)}
.--citeyes-icon-in,.--city--logoIcon{
  width:56px;height:56px;display:grid;place-items:center;border-radius:16px;
  background:var(--grad-cta);color:#fff;font-size:23px;box-shadow:0 8px 20px rgba(46,157,247,.3);margin-bottom:14px;
}
.--city-name--,.--city-name-- a{
  font-family:'Cairo',sans-serif!important;font-weight:800;color:var(--navy)!important;
  font-size:18px;transition:color .25s;
}
.--cites-single-box-:hover .--city-name-- a{color:var(--turq)!important}
.--city-content--{font-family:'Tajawal',sans-serif;color:var(--text2);font-size:14.5px;line-height:1.8}
.--city--info-boxitem{display:flex;flex-direction:column;gap:6px}
/* ==== RUKN v3 TEAM - rukn_team.css (ودجت جديدة) ====
   كروت فريق الخبراء بالأفاتار المتدرج */
/* Expert team */
.team-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px}
.tcard{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);padding:24px;text-align:center;transition:transform .3s ease,box-shadow .3s ease,border-color .3s}
.tcard:hover{transform:translateY(-8px);box-shadow:var(--sh-glow);border-color:transparent}
.tav{width:84px;height:84px;border-radius:50%;margin:0 auto 14px;display:grid;place-items:center;color:#fff;font-family:'Cairo';font-weight:900;font-size:30px;background:var(--grad-cta);box-shadow:var(--sh-glow)}
.tcard h3{font-size:19px;margin-bottom:3px}
.tcard .role{color:var(--turq);font-weight:700;font-size:14.5px;margin-bottom:10px}
.tcard .spec{color:var(--text2);font-size:13.5px;margin-bottom:14px;min-height:40px}
.tbadges{display:flex;flex-wrap:wrap;gap:6px;justify-content:center}
.tbadge{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:700;padding:5px 10px;border-radius:999px;background:var(--bg);border:1px solid var(--border);color:var(--text2)}
.tbadge i{color:var(--success);font-size:11px}

/* ==== WordPress adjustments ==== */
.-YC-WidgetType-rukn_team{padding:var(--pad) 0}
.-YC-WidgetType-rukn_team .-YC-Widgets-Inner-Row{padding:0}
.-YC-WidgetType-rukn_team.-Top-separator-shows__in{background:#fff}

/* الأفاتار بصورة حقيقية */
.tav.tav-img{background-size:cover;background-position:center top}

/* الريسبونسف */
@media (max-width:1200px){.team-grid{grid-template-columns:repeat(3,1fr)}}
@media (max-width:1024px){.team-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.team-grid{grid-template-columns:1fr 1fr;gap:12px}.tcard{padding:16px}.tcard .spec{min-height:0}}
/* ==== RUKN v3 PROJECTS - works_v1.css ====
   الفلاتر التفاعلية + كروت المشاريع
   (ستايلات .shead/.tag المشتركة في rukn-v3.css) */
/* ═══════════════ Projects ═══════════════ */
.filters{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:34px}
.filters button{font-family:'Cairo';font-weight:700;font-size:14.5px;padding:10px 20px;border-radius:999px;border:1.5px solid var(--border);background:#fff;color:var(--text2);cursor:pointer;transition:.25s}
.filters button.active,.filters button:hover{background:var(--grad-cta);color:#fff;border-color:transparent}
.proj-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.proj{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);overflow:hidden;transition:.35s}
.proj.hide{display:none}
.proj:hover{transform:translateY(-8px);box-shadow:var(--sh-l)}
.proj-img{height:200px;display:grid;place-items:center;color:#fff;font-size:40px;position:relative}
.proj-img .cat{position:absolute;top:14px;inset-inline-end:14px;background:rgba(255,255,255,.92);color:var(--navy);font-size:12px;font-weight:800;padding:5px 12px;border-radius:999px}
.proj-body{padding:22px}
.proj-body h3{font-size:19px;margin-bottom:6px}
.proj-meta{display:flex;flex-wrap:wrap;gap:14px;color:var(--muted);font-size:13.5px;margin:10px 0}
.proj-meta span{display:inline-flex;align-items:center;gap:6px}
.proj-res{display:flex;align-items:center;gap:8px;color:var(--success);font-weight:700;font-size:14px;border-top:1px solid var(--border);padding-top:14px;margin-top:4px}

/* ==== WordPress adjustments ==== */
/* حشوة القسم */
.-YC-WidgetType-works_v1{padding:var(--pad) 0}
.-YC-WidgetType-works_v1 .-YC-Widgets-Inner-Row{padding:0}

/* الخلفية البيضاء عند تفعيل السويتش */
.-YC-WidgetType-works_v1.-Top-separator-shows__in{background:#fff}

/* عنوان المشروع كرابط */
.proj-body h3 a{color:inherit;transition:color .25s}
.proj:hover .proj-body h3 a{color:var(--turq)}

/* الريسبونسف الخاص بالشبكة */
@media (max-width:1024px){.proj-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.proj-grid{grid-template-columns:1fr}}
/* ==== RUKN v3 PRICING GUIDES - price.css ====
   كروت أدلة الأسعار والتكاليف
   (ستايلات .shead/.tag المشتركة في rukn-v3.css) */
/* Pricing guides */
.price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.pcard{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);padding:26px;transition:transform .3s ease,box-shadow .3s ease,border-color .3s}
.pcard:hover{transform:translateY(-8px);box-shadow:var(--sh-glow);border-color:transparent}
.pcard .pic{width:56px;height:56px;border-radius:15px;background:linear-gradient(135deg,var(--blue),var(--turq));color:#fff;display:grid;place-items:center;font-size:23px;margin-bottom:16px}
.pcard h3{font-size:19px;margin-bottom:6px}
.pcard p{color:var(--text2);font-size:14px;margin-bottom:14px}
.pcard .range{display:flex;align-items:baseline;gap:8px;margin-bottom:16px}
.pcard .range b{font-family:'Cairo';font-weight:900;font-size:24px;color:var(--navy)}
.pcard .range small{color:var(--muted);font-size:13px}
.pcard .read{display:inline-flex;align-items:center;gap:8px;font-family:'Cairo';font-weight:700;color:var(--turq);font-size:15px}
.pcard .read i{transition:transform .25s}
.pcard:hover .read i{transform:translateX(-5px)}

/* ==== WordPress adjustments ==== */
/* حشوة القسم */
.-YC-WidgetType-price{padding:var(--pad) 0}
.-YC-WidgetType-price .-YC-Widgets-Inner-Row{padding:0}

/* الخلفية البيضاء عند تفعيل السويتش */
.-YC-WidgetType-price.-Top-separator-shows__in{background:#fff}

/* الريسبونسف الخاص بالشبكة */
@media (max-width:1024px){.price-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.price-grid{grid-template-columns:1fr}}
/* ==== RUKN v3 - rukn_brands.css (ودجت جديدة) ====
   شريط اللوجوهات المتحرك اللانهائي */
/* ═══════════════ Brands ═══════════════ */
.brands{background:var(--bg)}
.logo-cloud{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
.logo-track{display:flex;gap:60px;width:max-content;animation:scrollx 26s linear infinite}
.logo-track:hover{animation-play-state:paused}
@keyframes scrollx{to{transform:translateX(50%)}}
.brand{font-family:'Cairo';font-weight:900;font-size:26px;color:#9fb0c6;filter:grayscale(1);transition:.3s;white-space:nowrap;display:flex;align-items:center;gap:10px}
.brand i{font-size:24px}
.brand:hover{filter:none;color:var(--navy)}

/* ==== WordPress adjustments ==== */
.-YC-WidgetType-rukn_brands{padding:var(--pad) 0}
.-YC-WidgetType-rukn_brands .-YC-Widgets-Inner-Row{padding:0}
.-YC-WidgetType-rukn_brands{background:var(--bg)}
.-YC-WidgetType-rukn_brands.-Top-separator-shows__in{background:#fff}

/* لوجوهات الصور */
.brand img{max-height:44px;width:auto;filter:grayscale(1);opacity:.7;transition:.3s}
.brand:hover img{filter:none;opacity:1}

/* الريسبونسف */
@media (max-width:640px){.brand{font-size:20px}.logo-track{gap:36px}}
/* ==== RUKN v3 - rukn_cases.css (ودجت جديدة) ====
   قصص النجاح: المشكلة/التشخيص/الحل/النتيجة */
/* Case studies */
.cs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.cs{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);overflow:hidden;transition:transform .3s ease,box-shadow .3s ease}
.cs:hover{transform:translateY(-8px);box-shadow:var(--sh-l)}
.cs-top{padding:20px 24px;color:#fff;background:var(--grad);display:flex;align-items:center;gap:12px}
.cs-top i{width:46px;height:46px;border-radius:13px;background:rgba(255,255,255,.16);display:grid;place-items:center;font-size:20px;flex:none}
.cs-top b{font-family:'Cairo';font-weight:800;font-size:17px;display:block}
.cs-top small{color:rgba(255,255,255,.82);font-size:12.5px}
.cs-body{padding:22px 24px}
.cs-block{margin-bottom:14px}
.cs-block .k{display:flex;align-items:center;gap:8px;font-family:'Cairo';font-weight:700;font-size:13.5px;color:var(--turq);margin-bottom:3px}
.cs-block p{color:var(--text2);font-size:14px}
.cs-result{display:flex;align-items:center;gap:10px;background:rgba(24,201,106,.10);border:1px solid rgba(24,201,106,.25);border-radius:12px;padding:12px 14px;color:var(--success);font-weight:800;font-family:'Cairo';margin:14px 0}
.cs-result i{font-size:18px}
.cs-meta{display:grid;grid-template-columns:1fr 1fr;gap:8px;border-top:1px solid var(--border);padding-top:14px;margin-bottom:16px}
.cs-meta span{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:13px}
.cs-meta i{color:var(--blue)}
.cs .btn{width:100%}

/* ==== WordPress adjustments ==== */
.-YC-WidgetType-rukn_cases{padding:var(--pad) 0}
.-YC-WidgetType-rukn_cases .-YC-Widgets-Inner-Row{padding:0}
.-YC-WidgetType-rukn_cases.-Top-separator-shows__in{background:#fff}

/* الريسبونسف */
@media (max-width:1024px){.cs-grid{grid-template-columns:1fr 1fr}}
@media (max-width:640px){.cs-grid{grid-template-columns:1fr}}
/* ==== RUKN v3 COMPARE - rukn_compare.css (ودجت جديدة) ====
   جدول المقارنة برأس لاصق وعمود متدرج */
/* Service comparison */
.cmp{max-width:980px;margin:0 auto;background:#fff;border:1px solid var(--border);border-radius:var(--r-l);box-shadow:var(--sh-m);overflow:hidden}
.cmp-row{display:grid;grid-template-columns:1.6fr 1fr 1fr;align-items:center;border-bottom:1px solid var(--border)}
.cmp-row:last-child{border-bottom:none}
.cmp-head{position:sticky;top:70px;z-index:5;background:var(--navy);color:#fff}
.cmp-head .ch{padding:18px 20px;font-family:'Cairo';font-weight:800;font-size:16px;text-align:center}
.cmp-head .ch:first-child{text-align:start}
.cmp-head .ch.rk{background:var(--grad-cta)}
.cmp-row .cc{padding:16px 20px;font-size:15px}
.cmp-row .cc.lbl{font-family:'Cairo';font-weight:700;color:var(--navy)}
.cmp-row .cc.val{text-align:center;font-size:18px}
.cmp-row .cc.rk{background:rgba(46,157,247,.06);color:var(--success)}
.cmp-row .cc.ot{color:#c0392b}
.cmp-row:hover .cc{background:rgba(41,128,212,.04)}
.cmp-row:hover .cc.rk{background:rgba(46,157,247,.12)}

/* ==== WordPress adjustments ==== */
.-YC-WidgetType-rukn_compare{padding:var(--pad) 0}
.-YC-WidgetType-rukn_compare .-YC-Widgets-Inner-Row{padding:0}
.-YC-WidgetType-rukn_compare{background:#fff}
.-YC-WidgetType-rukn_compare.-Top-separator-shows__in{background:var(--bg)}

/* الرأس اللاصق يحسب ارتفاع الهيدر الثابت */
.cmp-head{top:78px}

/* لو المنافس عنده الميزة */
.cmp-row .cc.ot-yes{color:var(--success)}

/* الريسبونسف */
@media (max-width:640px){
  .cmp-row{grid-template-columns:1.3fr 1fr 1fr}
  .cmp-head .ch{padding:13px 10px;font-size:13.5px}
  .cmp-row .cc{padding:12px 10px;font-size:13.5px}
}
/* ==== RUKN v3 - rukn_hub.css (ودجت جديدة) ====
   أعمدة مركز المعرفة للسيو الداخلي */
/* SEO content hub */
.hub-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px}
.hub{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);padding:24px;transition:transform .3s ease,box-shadow .3s ease,border-color .3s}
.hub:hover{transform:translateY(-6px);box-shadow:var(--sh-m);border-color:var(--turq)}
.hub-ic{width:52px;height:52px;border-radius:14px;background:rgba(46,157,247,.12);color:var(--turq);display:grid;place-items:center;font-size:21px;margin-bottom:14px}
.hub h3{font-size:18px;margin-bottom:12px}
.hub .feat-guide{display:block;font-weight:700;color:var(--navy);font-size:14px;background:var(--bg);border:1px solid var(--border);border-radius:11px;padding:10px 12px;margin-bottom:12px;transition:.25s}
.hub .feat-guide:hover{border-color:var(--turq);color:var(--turq)}
.hub ul{display:grid;gap:9px}
.hub ul a{display:flex;align-items:center;gap:8px;font-size:13.5px;color:var(--text2);transition:.2s}
.hub ul a:hover{color:var(--turq);padding-inline-start:3px}
.hub ul a i{font-size:10px;color:var(--turq)}

/* ==== WordPress adjustments ==== */
.-YC-WidgetType-rukn_hub{padding:var(--pad) 0}
.-YC-WidgetType-rukn_hub .-YC-Widgets-Inner-Row{padding:0}
.-YC-WidgetType-rukn_hub.-Top-separator-shows__in{background:#fff}

/* الريسبونسف */
@media (max-width:1200px){.hub-grid{grid-template-columns:repeat(3,1fr)}}
@media (max-width:1024px){.hub-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.hub-grid{grid-template-columns:1fr}}
/* ==== RUKN v3 BEFORE/AFTER - rukn_results.css (ودجت جديدة) ====
   سلايدر السحب التفاعلي قبل/بعد */
/* ═══════════════ Before/After ═══════════════ */
.ba-wrap{display:grid;grid-template-columns:1fr;gap:26px;max-width:980px;margin:0 auto}
.ba{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);overflow:hidden;box-shadow:var(--sh-s)}
.ba-stage{position:relative;height:380px;overflow:hidden;user-select:none;touch-action:none}
.ba-img{position:absolute;inset:0;display:grid;place-items:center;font-family:'Cairo';font-weight:800;font-size:20px;color:#fff;text-shadow:0 2px 12px rgba(0,0,0,.35)}
.ba-after{background:linear-gradient(135deg,var(--turq),var(--blue))}
.ba-before{background:linear-gradient(135deg,#3a4a5e,#1c2e44);clip-path:inset(0 0 0 50%)}
.ba-label{position:absolute;top:16px;padding:6px 14px;border-radius:999px;font-size:13px;font-weight:800;backdrop-filter:blur(6px)}
.ba-label.b{inset-inline-start:16px;background:rgba(0,0,0,.45);color:#fff}
.ba-label.a{inset-inline-end:16px;background:rgba(46,157,247,.85);color:#fff}
.ba-handle{position:absolute;top:0;bottom:0;left:50%;width:4px;background:#fff;transform:translateX(-50%);cursor:ew-resize}
.ba-handle .grip{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;background:#fff;display:grid;place-items:center;color:var(--navy);box-shadow:var(--sh-m);font-size:16px}
.ba-info{padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.ba-info b{font-family:'Cairo';font-size:19px}
.ba-info small{color:var(--text2)}

/* ==== WordPress adjustments ==== */
.-YC-WidgetType-rukn_results{padding:var(--pad) 0}
.-YC-WidgetType-rukn_results .-YC-Widgets-Inner-Row{padding:0}
.-YC-WidgetType-rukn_results{background:#fff}
.-YC-WidgetType-rukn_results.-Top-separator-shows__in{background:var(--bg)}

/* الريسبونسف */
@media (max-width:640px){
  .ba-stage{height:280px}
  .ba-info{padding:16px 18px}
  .ba-info .btn{width:100%;justify-content:center}
}
/* ==== RUKN v3 BLOG - blog_v1.css ====
   كروت المقالات
   (ستايلات .shead/.tag المشتركة في rukn-v3.css) */
/* ═══════════════ Blog ═══════════════ */
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.post{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);overflow:hidden;transition:.35s}
.post:hover{transform:translateY(-8px);box-shadow:var(--sh-l)}
.post-img{height:190px;display:grid;place-items:center;color:#fff;font-size:36px}
.post-body{padding:24px}
.post-cat{display:inline-block;font-size:12px;font-weight:800;color:var(--turq);background:rgba(46,157,247,.10);padding:5px 12px;border-radius:999px;margin-bottom:12px}
.post-date{color:var(--muted);font-size:13px;margin-inline-start:8px}
.post h3{font-size:20px;margin-bottom:10px;line-height:1.4}
.post p{color:var(--text2);font-size:14.5px;margin-bottom:16px}
.post a.read{display:inline-flex;align-items:center;gap:8px;color:var(--turq);font-family:'Cairo';font-weight:700;font-size:15px}
.post a.read i{transition:transform .25s}
.post:hover a.read i{transform:translateX(-5px)}

/* ==== WordPress adjustments ==== */
/* حشوة القسم */
.-YC-WidgetType-blog_v1{padding:var(--pad) 0}
.-YC-WidgetType-blog_v1 .-YC-Widgets-Inner-Row{padding:0}

/* الخلفية البيضاء (القسم أبيض في التصميم الأصلي — فعّل سويتش الخلفية) */
.-YC-WidgetType-blog_v1.-Top-separator-shows__in{background:#fff}

/* صورة المقال كرابط */
a.post-img{display:grid;text-decoration:none}

/* عنوان المقال كرابط */
.post h3 a{color:inherit;transition:color .25s}
.post:hover h3 a{color:var(--turq)}

/* زرار المزيد من المقالات */
.blog-more-wrap{text-align:center;margin-top:44px}

/* الريسبونسف الخاص بالشبكة */
@media (max-width:1024px){.blog-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.blog-grid{grid-template-columns:1fr}}
/* ==== RUKN v3 CONTACT / FINAL CTA - contact__form.css ====
   الشريط الختامي الكحلي + فورم التواصل الكامل
   (ستايلات .fld/.form-grid/.sel/.form-note المشتركة في rukn-v3.css) */

/* ==== WordPress adjustments + عناصر الفورم ==== */
/* حشوة القسم */
.-YC-WidgetType-contact__form{padding:0}
.-YC-WidgetType-contact__form .-YC-Widgets-Inner-Row{padding:0}

/* وضع CTA — الشريط الكحلي بيغطي عرض القسم بالكامل */
.rukn-fcta{position:relative;background:var(--grad);color:#fff;text-align:center;overflow:hidden;padding:var(--pad) 0}
.rukn-fcta::before{content:"";position:absolute;inset:0;background:radial-gradient(600px 400px at 50% 0,rgba(79,168,255,.25),transparent 60%)}
.rukn-fcta .wrap{position:relative;z-index:2}
.rukn-fcta h2{color:#fff;margin-bottom:14px}
.rukn-fcta p{color:rgba(255,255,255,.86);font-size:19px;max-width:620px;margin:0 auto 30px}
.fcta-btns{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-bottom:30px}
.fcta-trust{display:flex;flex-wrap:wrap;gap:24px;justify-content:center}
.fcta-trust span{display:inline-flex;align-items:center;gap:9px;font-weight:700;font-size:15px}
.fcta-trust i{color:var(--aqua)}

/* وضع FORM — حشوة القسم */
.-YC-WidgetType-contact__form:has(.rukn-contact-grid){padding:var(--pad) 0}
.-YC-WidgetType-contact__form.-Top-separator-shows__in{background:#fff}

/* شبكة عمودي المعلومات والفورم */
.rukn-contact-grid{display:grid;grid-template-columns:360px 1fr;gap:28px;align-items:start}

/* عمود معلومات التواصل */
.rukn-contact-info{display:grid;gap:14px}
.cinfo-item{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--border);border-radius:var(--r-s);padding:18px 20px;color:inherit;transition:.3s}
.cinfo-item:hover{transform:translateY(-4px);box-shadow:var(--sh-m);border-color:rgba(46,157,247,.35)}
.cinfo-ic{width:48px;height:48px;flex:none;display:grid;place-items:center;border-radius:14px;background:var(--grad-cta);color:#fff;font-size:19px}
.cinfo-item b{display:block;font-family:'Cairo';font-size:15.5px;color:var(--navy)}
.cinfo-item small{color:var(--text2);font-size:14px;direction:ltr;text-align:right;display:block}
.cinfo-social{display:flex;gap:10px;margin-top:6px}
.cinfo-social a{width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:#fff;border:1px solid var(--border);color:var(--blue);font-size:17px;transition:.25s}
.cinfo-social a:hover{background:var(--grad-cta);color:#fff;border-color:transparent;transform:translateY(-3px)}

/* عمود الفورم */
.rukn-contact-form{background:#fff;border:1px solid var(--border);border-radius:var(--r-m);padding:34px;box-shadow:var(--sh-s)}
.rukn-contact-form h3{font-size:22px;margin-bottom:22px;color:var(--navy)}
.rukn-contact-form .rukn-form-submit{width:100%;margin-top:20px;justify-content:center}

/* تنبيهات الإرسال */
.rukn-form-alert{margin-top:16px;padding:14px 18px;border-radius:12px;font-weight:700;font-size:14.5px;display:flex;align-items:center;gap:10px}
.rukn-form-success{background:rgba(24,201,106,.12);color:#0e8a47;border:1px solid rgba(24,201,106,.3)}
.rukn-form-error{background:rgba(255,77,79,.10);color:#c62828;border:1px solid rgba(255,77,79,.3)}

/* تحييد ستايلات الحقول القديمة في forms.css داخل الفورم الجديد */
.rukn-contact-form input,.rukn-contact-form textarea,.rukn-contact-form select{min-height:0;box-shadow:none}

/* الريسبونسف */
@media (max-width:1024px){
  .rukn-contact-grid{grid-template-columns:1fr}
}
@media (max-width:640px){
  .rukn-contact-form{padding:24px 18px}
  .fcta-btns .btn{width:100%;justify-content:center}
}
/* ==== RUKN v3 FAQ - Faqs__simple2.css ====
   أكورديون الأسئلة الشائعة بالفلاتر
   (نسخة احتياطية كاملة — القواعد الأساسية موجودة أيضاً في rukn-v3.css) */
/* ═══════════════ FAQ ═══════════════ */
.faq-wrap{max-width:880px;margin:0 auto}
.faq-cats{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:30px}
.faq-cats button{font-family:'Cairo';font-weight:700;font-size:14px;padding:9px 18px;border-radius:999px;border:1.5px solid var(--border);background:#fff;color:var(--text2);cursor:pointer;transition:.25s}
.faq-cats button.active{background:var(--grad-cta);color:#fff;border-color:transparent}
.faq-item{background:#fff;border:1px solid var(--border);border-radius:var(--r-s);margin-bottom:14px;overflow:hidden;transition:.3s}
.faq-item.hide{display:none}
.faq-item.faq-open{border-color:var(--turq);box-shadow:var(--sh-s)}
.faq-q{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:20px 24px;cursor:pointer;font-family:'Cairo';font-weight:700;font-size:17px;color:var(--navy)}
.faq-q i{color:var(--turq);transition:transform .3s;flex:none}
.faq-item.faq-open .faq-q i{transform:rotate(180deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .4s ease}
.faq-a p{padding:0 24px 22px;color:var(--text2);font-size:15.5px}

/* ==== WordPress adjustments ==== */
/* حشوة القسم */
.-YC-WidgetType-Faqs__simple2{padding:var(--pad) 0}
.-YC-WidgetType-Faqs__simple2 .-YC-Widgets-Inner-Row{padding:0}

/* الخلفية البيضاء عند تفعيل السويتش */
.-YC-WidgetType-Faqs__simple2.-Top-separator-shows__in{background:#fff}

/* فقرات الإجابة من محرر ووردبريس */
.faq-a p+p{margin-top:0;padding-top:0}

/* ═══ توافق قالب صفحة الأسئلة (@models/faqs.php) ═══ */
.-YC-FaqsSimple-Center-v1{max-width:880px;margin:0 auto;padding:50px 0}
.-YC-FaqsSimple-ItemsCenter-v1{display:grid;gap:14px}
.-YC-FaqsSimple-Item-v1{
  background:#fff;border:1px solid var(--border);border-radius:var(--r-s);
  overflow:hidden;box-shadow:var(--sh-s);transition:border-color .3s;
}
.-YC-FaqsSimple-Item-v1.active,.-YC-FaqsSimple-Item-v1:hover{border-color:rgba(46,157,247,.4)}
.-YC-FaqsSimple-Title{
  display:flex;align-items:center;justify-content:space-between;gap:14px;
  padding:18px 24px;cursor:pointer;
  font-family:'Cairo',sans-serif!important;font-weight:800;color:var(--navy);font-size:16.5px;
}
.--YC-icon-faq-{color:var(--turq);transition:transform .3s;flex:none}
.-YC-FaqsSimple-Item-v1.active .--YC-icon-faq-,
.--YC-faq-classes-in--.active .--YC-icon-faq-{transform:rotate(180deg)}
.-FaqsSimple-Content-Row-v1{padding:0 24px}
.-p-FaqsSimple-ContentValue-v1{
  font-family:'Tajawal',sans-serif;color:var(--text2);font-size:15.5px;line-height:1.9;padding-bottom:22px;
}
.-fix-forms-field-title::before,.-input-password-ivid>.-show-password-item,.-password-status {
    top: 50%;
    transform: translateY(-50%);
    position: absolute
}

.-CheckBox-Box-Item span,.-Radio-Box-Item span {
    width: 18px;
    height: 18px;
    background: #a1a5a8;
    box-shadow: rgba(219,43,72,0) 0 0 0 3px;
    transform: translate(0,-50%)
}

.-PhoneNumber-Field-YC input[type=number] {
    text-align: left;
    direction: ltr
}

.-is-necessary input[type=text] {
    border: 1px solid #991229
}

.-fix-inputs-area.-is-necessary input,.-fix-inputs-area.-is-necessary textarea {
    animation: 1.5s is-necessary
}

@keyframes is-necessary {
    0%,60%,80% {
        border-color: var(--diver)
    }

    100%,40%,70% {
        border-color: var(--negative)
    }
}

.-fix-inputs-area {
    margin: 0 0 40px;
    flex-flow: column wrap;
    position: relative;
    display: flex;
    align-content: flex-start;
    align-items: flex-start
}

.-fix-inputs-area .iti__flag {
    margin-inline-end:7px}

.-fix-inputs-area .iti--separate-dial-code input[type=tel] {
    padding-inline-start:15px;direction: ltr
}

.-fix-inputs-area .iti--separate-dial-code .iti__selected-flag {
    background: 0 0;
    border-inline-start:1px solid var(--diver);padding-inline-start: 20px;
    border-radius: var(--miniradius) 0 0 var(--miniradius)
}

.-fix-inputs-area .iti--allow-dropdown {
    width: 100%;
    direction: ltr;
    flex: 1 1 0%
}

.-fix-inputs-area.-for-date-field {
    flex-flow: row wrap;
    align-content: center;
    align-items: center
}

.-fix-forms-field-title {
    display: flex;
    align-content: center;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    position: relative;
    padding-inline-start:15px}

.-password-status {
    text-align: center;
    border-radius: var(--largeradius);
    font-size: 13px;
    font-weight: 400;
    left: 55px;
    color: var(--item-uicolor)
}

.-Radio-Box-Item,.-Radio-Box-Item input[type=radio],necessary {
    border-radius: var(--miniradius)
}

.-input-password-ivid {
    display: flex;
    flex: 1;
    width: 100%;
    position: relative
}

.-input-password-ivid[passowrd-level="0"],.-input-password-ivid[passowrd-level="1"] {
    --item-uicolor: #e65054
}

.-input-password-ivid[passowrd-level="2"] {
    --item-uicolor: #f86368
}

.-input-password-ivid[passowrd-level="3"] {
    --item-uicolor: #f0c33c
}

.-input-password-ivid[passowrd-level="4"] {
    --item-uicolor: #68de7c
}

.-input-password-ivid input[type=password]:focus {
    border-color: var(--item-uicolor)
}

.-input-password-ivid>.-show-password-item {
    left: auto;
    color: var(--secondarytext);
    border-radius: var(--miniradius);
    cursor: pointer;
    width: 25px;
    text-align: center;
    transition: 180ms;
    font-size: 20px;
    margin-inline-start:calc(100% - 40px);line-height: 0
}

.-input-password-ivid>.-show-password-item:hover {
    color: var(--primary-text)
}

.-fix-forms-field-title::before {
    content: "";
    width: 6px;
    display: block;
    background: rgba(0,0,0,.06);
    border-radius: 10px;
    height: 16px;
    margin-inline-start:-16px;right: auto;
    left: auto
}

.-fix-forms-field-title>h3 {
    font-size: 17px;
    font-weight: 500;
    margin-inline-end:10px;line-height: 1.5
}

.-CheckBox-Box-Item em,.-Radio-Box-Item em {
    font-size: 15px;
    font-style: normal;
    transition: 180ms;
    /* white-space: nowrap; */
    line-height: 1.7;
}

.-fix-forms-field-title>descor {
    position: relative;
    color: #858497;
    cursor: pointer;
    display: flex;
    align-content: center;
    align-items: center
}

.-fix-forms-field-title>descor>i {
    font-weight: 300
}

necessary {
    display: block;
    min-width: 100%;
    margin-bottom: 10px;
    font-size: 12px;
    color: #991229;
    box-sizing: border-box
}

.-Radio-Box-InnerArea {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -5px;
    flex: 1 1 0%
}

.-Radio-Box-Item {
    display: flex;
    padding: 17px 50px 17px 20px;
    align-content: center;
    align-items: center;
    margin: 0 5px 10px;
    flex: 1 1 0%;
    min-width: max-content;
    position: relative;
    overflow: hidden;
    background: #fff
}

.-Radio-Box-Item input[type=radio] {
    position: absolute;
    width: 100%;
    height: 100%;
    right: 0;
    top: 0;
    z-index: 1;
    transition: 180ms;
    background: #fff;
    appearance: none;
    cursor: pointer;
    margin: 0!important
}

.-CheckBox-Box-Item input[type=checkbox]:checked,.-Radio-Box-Item input[type=radio]:checked {
    background: #0095ff12;
    border-color: #edf8ff;
}

.-Radio-Box-Item input[type=radio]:checked+span {
    transform: scale(1.2) translate(0,-39%);
    background: rgba(31,30,135,.18);
    box-shadow: rgb(255 255 255) 0 0 0 3px;
}

.-Radio-Box-Item em {
    display: block;
    position: relative;
    z-index: 1;
    font-weight: 400;
    color: var(--secondarytext);
}

.-CheckBox-Box-Item input[type=checkbox]:checked+span+em,.-CheckBox-Box-Item:hover em,.-Radio-Box-Item:hover em {
    color: #041c36
}

.-Radio-Box-Item input[type=radio]:checked+span+em {
    color: #363636
}

.-Radio-Box-Item span {
    display: block;
    border-radius: 50%;
    position: absolute;
    right: 17px;
    transition: 180ms;
    top: 50%
}

.-CheckBox-Box-Item:hover>span,.-Radio-Box-Item:hover>span {
    background: #041c36
}

.-Radio-Box-Item span::before {
    content: "";
    position: absolute;
    width: calc(100% - 6px);
    height: calc(100% - 6px);
    background: #fff;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
    border-radius: 50%;
    box-shadow: rgba(0,0,0,.19) 1px 1px 2px;
    transition: 180ms
}

.-CheckBox-Box-Item input[type=checkbox]:checked+span::before,.-Radio-Box-Item input[type=radio]:checked+span::before {
    background: var(--uicolor)
}

.-Radio-Box-Item input[type=radio i] {
    border: 1px solid var(--diver);
    background: 0 0;
    outline: 0;
    box-shadow: 0 0;
    z-index: 2;
    display: block
}

.-Radio-Box-Item input[type=radio]::before,.-Radio-Box-Item input[type=radio]:checked::before {
    content: "";
    display: none
}

.-CheckBox-Box-InnerArea {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -5px
}

.-CheckBox-Box-Item {
    display: flex;
    padding: 13px 45px 13px 15px;
    align-content: center;
    align-items: center;
    margin: 0 5px 10px;
    border-radius: var(--largeradius);
    flex: 1 1 0%;
    min-width: max-content;
    position: relative;
    background: #fff
}

.-CheckBox-Box-Item input[type=checkbox] {
    position: absolute;
    right: 0;
    top: 0;
    z-index: 2;
    border-radius: var(--largeradius);
    transition: 180ms;
    background: rgba(255,255,255,0);
    box-shadow: 0 0 0;
    display: block;
    appearance: none;
    cursor: pointer;
    width: 100%!important;
    height: 100%!important;
    margin: 0!important;
    border: 1px solid var(--diver)!important
}

.-CheckBox-Box-Item.Has-ParentChilds {
    min-width: 320px
}

.-CheckBox-Box-Item input[type=checkbox]:checked+span {
    transform: scale(1.2) translate(0,-39%);
    background: rgba(31,30,135,.16);
    box-shadow: rgba(31,30,135,.04) 0 0 0 3px
}

.-CheckBox-Box-Item em {
    display: block;
    position: relative;
    z-index: 1;
    font-weight: 400;
    color: #858497;
    flex: 1 1 0%
}

.-CheckBox-Box-Item span {
    display: block;
    border-radius: 30%;
    position: absolute;
    right: 15px;
    transition: 180ms;
    top: 50%
}

.-CheckBox-Box-Item span::before {
    content: "";
    position: absolute;
    width: calc(100% - 6px);
    height: calc(100% - 6px);
    background: #fff;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
    border-radius: 30%;
    transition: 180ms
}

.-CheckBox-Box-Item span::after {
    content: var(--check-icon);
    position: absolute;
    font-family: "Font Awesome 6 Free";
    color: #fff;
    font-size: 18px;
    right: -1px;
    z-index: 1;
    visibility: hidden;
    opacity: 0;
    transition: 180ms;
    top: 50%;
    transform: translateY(-50%)
}

.-CheckBox-Box-Item input[type=checkbox]:checked+span::after,.-Select-Field-Code.active .-Select-DropDown-PoneNumber,.Select-Options-Items.active .-Select-DropDown,switchfield>input[type=checkbox]:checked~.Switch>strong {
    visibility: visible;
    opacity: 1
}

.-Select-DropDown,switchfield>.Switch>strong,switchfield>input[type=checkbox]:checked~.Switch>span {
    visibility: hidden;
    opacity: 0
}

.-CheckBox-Box-Item input[type=radio i] {
    border: 1px solid var(--diver);
    background: 0 0;
    outline: 0;
    box-shadow: 0 0;
    z-index: 2
}

.-CheckBox-Box-Item input[type=checkbox]::before {
    display: none!important
}

.-YC-Forms-button {
    display: flex;
    justify-content: flex-end;
    margin: 10px 0 0;
    position: sticky;
    bottom: 0;
    z-index: 2;
}

.-YC-Forms-button:before {
    content: '';
    position: absolute;
    right: 0;
    height: 100%;
    left: 0;
    background: linear-gradient(0deg, white, transparent);
    z-index: -1;
}

.-YC-Forms-button>.YC-BTN-Forms-Plugin {
    display: block;
    background: var(--positive);
    border: 0;
    padding: 13px 16px;
    border-radius: var(--largeradius);
    color: #fff;
    cursor: pointer;
    margin-right: 5px;
    font-size: 17px;
    font-weight: 400;
}

.-YC-Forms-button>.YC-BTN-Forms-Plugin>i {
    margin: 0 5px
}

.-YC-Forms-button>.YC-BTN-Forms-Plugin.Next-Step-Action {
    background: 0 0;
    color: #1a1a64
}

.Select-Options-Items {
    display: block;
    min-width: 170px;
    position: relative;
    flex: 1 1 0%
}

.Select-Options-Items>h2 {
    display: flex;
    padding: 20px 15px;
    justify-content: space-between;
    width: 100%;
    border: 1px solid var(--diver);
    border-radius: var(--miniradius);
    cursor: pointer;
    font-weight: 400;
    height: 60px;
    font-size: 14px;
    align-items: center;
    background: var(--bgcolor);
    overflow: hidden
}

.Select-Options-Items>h2>span {
    margin-inline-end:15px;display: block;
    flex: 1 1 0%;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden
}

.Select-Options-Items>h2>span>.-field-select-image {
    margin-left: 10px;
    height: 32px;
    max-width: 32px;
    position: relative;
    overflow: hidden;
    border-radius: var(--miniradius);
    box-shadow: rgba(31,30,135,.02) 0 2px 3px,rgba(72,71,237,.06) 0 3px 10px;
    min-width: 32px;
    max-height: 32px
}

.-select-Code-number-title>span>.-field-select-image>img,.Select-Options-Items>h2>span>.-field-select-image>img {
    position: absolute;
    min-width: 100%;
    max-width: unset;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    min-height: 100%;
    max-height: 100%
}

.-Select-DropDown {
    position: absolute;
    background: rgb(255 255 255);
    box-shadow: rgb(0 0 0 / 2%) 0 2px 3px,rgb(0 0 0 / 6%) 0 8px 35px;
    border-radius: var(--miniradius);
    min-width: 240px;
    right: 0;
    padding: 10px;
    z-index: 90;
    top: calc(100% - -8px);
    max-height: 391px;
    margin: 0;
    display: flex;
    flex-flow: column wrap
}

.-Select-DropDown-PoneNumber .Lists-Select-Items-PoneNumber,.Select-Options-Items .Lists-Select-Items {
    position: relative;
    min-width: 100%;
    overflow: auto;
    margin: 0;
    max-height: 265px
}

.Select-Options-Items .Lists-Select-Items::-webkit-scrollbar {
    width: 4px;
    height: 4px
}

.Select-Options-Items .Lists-Select-Items::-webkit-scrollbar-thumb {
    background: linear-gradient(0deg,transparent 10%,transparent 0,transparent 90%,transparent 0)
}

.Select-Options-Items .Lists-Select-Items::-webkit-scrollbar-track {
    background: 0 0
}

.Select-Options-Items .Lists-Select-Items:hover::-webkit-scrollbar-thumb {
    background: linear-gradient(0deg,transparent 10%,rgba(0,0,0,.03) 0,rgba(0,0,0,.03) 90%,transparent 0)
}

.Lists-Select-Items-PoneNumber>li,.Select-Options-Items .Lists-Select-Items>li {
    display: flex;
    padding: 12px 13px;
    border: 1px solid transparent;
    border-radius: var(--miniradius);
    cursor: pointer;
    transition: 180ms;
    align-content: center;
    align-items: center;
    font-weight: 400;
    font-size: 14px;
    margin-bottom: 5px
}

.Select-Options-Items .Lists-Select-Items>li:hover {
    background: var(--uioverlaycolor)
}

.Select-Options-Items .Lists-Select-Items>li::before {
    content: var(--plus-icon);
    font-family: "Font Awesome 6 Free";
    font-size: 14px;
    color: var(--secondarytext);
    position: relative;
    margin-left: 10px;
    font-weight: 900;
    display: flex;
    align-content: center;
    align-items: center;
    line-height: 1.6
}

.Select-Options-Items .Lists-Select-Items>li.active::before {
    color: var(--uicolor)
}

.-Select-Cuntryes-Item .Select-Options-Items .Lists-Select-Items>li::before {
    display: none
}

.Select-Options-Items .Lists-Select-Items>li.active {
    background: var(--uioverlaycolor);
    border-color: var(--uioverlaycolor);
    color: var(--uicolor)
}

.Lists-Select-Items-PoneNumber>li .-field-select-image,.Select-Options-Items .Lists-Select-Items>li .-field-select-image {
    display: block;
    max-width: 32px;
    min-width: 32px;
    overflow: hidden;
    margin-left: 10px;
    border-radius: 50%;
    height: 32px;
    position: relative;
    border: 1px solid rgba(0,0,0,.12);
    box-shadow: rgba(0,0,0,.07) 0 2px 3px,rgba(0,0,0,.05) 0 3px 14px
}

.Select-Options-Items .Lists-Select-Items>li .-field-select-image>img {
    max-height: 100%;
    min-height: 100%;
    min-width: 100%;
    position: absolute;
    left: 50%;
    transform: translate(-50%,-50%);
    top: 50%;
    max-width: unset
}

.Select-Options-Items .Lists-Select-Items>li>em {
    font-size: 11px;
    color: var(--secondarytext);
    margin-right: 5px
}

switchfield {
    display: block;
    position: relative
}

switchfield>.Switch {
    display: block;
    width: 130px;
    position: relative;
    background: #e4e6eb0f;
    height: 50px;
    border-radius: 40px;
    color: #858497;
    cursor: pointer;
    transition: 180ms
}

switchfield>.Switch>span,switchfield>.Switch>strong {
    position: absolute;
    width: max-content;
    top: 50%;
    transform: translateY(-50%);
    left: 15px;
    font-size: 17px;
    font-weight: 300;
    transition: 180ms
}

switchfield>.Switch>strong {
    right: 15px;
    left: 0
}

switchfield>.Switch>em {
    position: absolute;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transform: translateY(-50%);
    right: 5px;
    background: var(--secondarytext);
    top: 50%;
    transition: 180ms
}

switchfield>input[type=checkbox]:checked~.Switch>em {
    transform: translate(-80px,-50%);
    background: #fff
}

switchfield>input[type=checkbox]:checked~.Switch {
    background: var(--uicolor);
    color: #fff
}

switchfield>input[type=checkbox] {
    position: absolute;
    width: 100%;
    height: 100%;
    background: 0 0;
    box-shadow: 0 0 0;
    z-index: 1;
    top: 0;
    right: 0;
    left: 0;
    display: block;
    appearance: none;
    cursor: pointer;
    border: 0!important
}

.-PhoneNumber-Field-YC {
    flex: 1 1 0%;
    display: flex;
    flex-wrap: wrap;
    width: 100%
}

.-Select-Field-Code {
    display: block;
    position: relative;
    margin-left: 15px;
    max-width: 180px;
    min-width: 180px
}

.-select-Code-number-title {
    display: flex;
    place-content: center space-between;
    width: 100%;
    border: 1px solid var(--diver);
    border-radius: var(--miniradius);
    cursor: pointer;
    height: 60px;
    align-items: center;
    background: #fff;
    box-sizing: border-box;
    margin: 0;
    overflow: hidden;
    padding: 20px 15px!important;
    font-weight: 500!important;
    font-size: 14px!important;
    line-height: unset!important
}

.-select-Code-number-title>span {
    margin-left: 10px;
    display: flex;
    place-content: center flex-start;
    align-items: center;
    flex: 1 1 0%;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    max-width: 100%
}

.-select-Code-number-title>span>span {
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap;
    justify-content: flex-start;
    display: block
}

.-select-Code-number-title>span em {
    font-style: unset;
    font-size: 11px
}

.-select-Code-number-title>span>.-field-select-image {
    margin-left: 10px;
    height: 32px;
    min-width: 32px;
    position: relative;
    overflow: hidden;
    border-radius: var(--miniradius);
    box-shadow: rgba(31,30,135,.02) 0 2px 3px,rgba(72,71,237,.06) 0 3px 10px
}

.-Select-DropDown-PoneNumber {
    position: absolute;
    visibility: hidden;
    opacity: 0;
    background: #fff;
    box-shadow: rgba(31,30,135,.02) 0 2px 3px,rgba(72,71,237,.06) 0 8px 35px;
    border-radius: var(--largeradius);
    min-width: 250px;
    right: 0;
    padding: 10px;
    z-index: 90;
    top: calc(100% - -8px);
    max-height: 390px;
    margin: 0;
    display: flex;
    flex-flow: column wrap
}

.Lists-Select-Items-PoneNumber>li:hover {
    background: #f4f4f4;
    color: #041c36
}

.Lists-Select-Items-PoneNumber>li.active {
    background: #f3f3ff;
    border-color: rgba(31,30,135,.02);
    color: var(--uicolor)
}

.Lists-Select-Items-PoneNumber>li em {
    color: #464646;
    font-style: normal
}

.Lists-Select-Items-PoneNumber>li .-field-select-image>img {
    max-width: unset;
    max-height: 100%;
    min-height: 100%;
    position: absolute
}

.Lists-Select-Items-PoneNumber:hover::-webkit-scrollbar-thumb {
    background: linear-gradient(0deg,transparent 10%,rgba(0,0,0,.03) 0,rgba(0,0,0,.03) 90%,transparent 0)
}

.Lists-Select-Items-PoneNumber::-webkit-scrollbar-thumb {
    background: linear-gradient(0deg,transparent 10%,transparent 0,transparent 90%,transparent 0)
}

.Lists-Select-Items-PoneNumber::-webkit-scrollbar-track {
    background: 0 0
}

.Lists-Select-Items-PoneNumber::-webkit-scrollbar {
    width: 4px;
    height: 4px
}

.-select--posts--top-area {
    display: flex;
    align-items: stretch;
    border-radius: var(--largeradius);
    flex-direction: column;
    width: 100%
}

.--result-my-fix-posts-select {
    width: 0;
    align-items: center;
    overflow: hidden;
    border-radius: var(--largeradius);
    background: #f5faff;
    height: 0
}

.-Your-selected-title {
    min-width: 100px;
    max-width: 100px;
    font-size: 22px;
    line-height: 1.3;
    margin-inline-end:40px;font-weight: 400;
    color: var(--primary-text)
}

.-scroller-slider-findors-UL {
    display: block;
    flex: 1;
    overflow: hidden;
    margin: -20px;
    position: relative
}

.-fix-selcted-items {
    display: flex;
    flex-wrap: nowrap;
    max-width: 100%;
    overflow: auto;
    padding: 20px
}

.-result-searching-too {
    display: block;
    margin-top: 30px;
    font-size: 23px;
    color: var(--secondarytext)
}

.-result-searching-too:empty {
    display: none;
    margin-top: 0
}

.-searching--result--selected {
    display: flex;
    background: #fff;
    margin: 10px -10px -10px;
    flex-wrap: wrap
}

.-searching--result--selected .-currrent-single-elements:last-child {
    margin-bottom: 0
}

.--platforms-select-Box.active {
    color: var(--uicolor);
    border-color: var(--uicolor)
}

.--platforms-select-Box {
    display: flex;
    padding: 25px;
    background: #fff;
    margin: 15px;
    border-radius: var(--largeradius);
    position: relative;
    align-items: center;
    cursor: pointer;
    transition: 80ms;
    border: var(--border-defult);
    box-shadow: var(--box-shadow-defult);
    flex: 1;
    min-width: max-content;
    font-size: 18px;
    color: var(--secondarytext)
}

.--platforms-select-Box: not(.active):hover {
    border-color:var(--border-defult-hover);
    box-shadow: var(--box-shadow-hover);
    transition: 280ms;
    color: var(--primary-text)
}

.-searching--result--selected .--platforms-select-Box {
    margin: 10px
}

.-aps--tools-action {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    right: 0;
    z-index: 1;
    cursor: pointer;
    display: none
}

.-searching--result--selected .--platforms-select-Box .-aps--tools-action {
    display: block
}

.Thumb--II {
    display: flex;
    --elem-w: 40px;
    min-width: var(--elem-w);
    max-width: var(--elem-w);
    height: var(--elem-w);
    position: relative;
    overflow: hidden;
    border-radius: var(--miniradius);
    background: #f7f7f7;
    margin-inline-end:15px;align-items: center;
    justify-content: center
}

.--platforms-select-Box.active .Thumb--II {
    color: var(--secondarytext);
    --elem-w: 38px
}

.Thumb--II>.-avatar-append-image {
    display: block
}

.Thumb--II>.-avatar-append-image>i {
    font-style: normal
}

.--platforms-select-Box-box-title {
    flex: 1;
    display: block;
    overflow: hidden
}

.--platforms-select-Box>.--platforms-select-Box-box-title>a {
    display: block;
    text-decoration: none;
    font-size: 19px;
    color: var(--secondarytext)!important;
    z-index: 2;
    font-weight: 400;
    transition: 180ms;
    line-height: 1.4;
    text-overflow: ellipsis;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap
}

.--platforms-select-Box.active>.--platforms-select-Box-box-title>a {
    color: var(--primary-text)!important;
    font-size: 18px
}

.-remove-custom-post-select-tools {
    display: flex;
    margin-inline-start:15px;font-size: 20px;
    color: var(--secondarytext);
    z-index: 2;
    cursor: pointer;
    transition: 180ms;
    min-width: 38px!important;
    max-width: 38px!important;
    text-align: center;
    border-radius: 50%;
    overflow: hidden;
    opacity: .6;
    box-sizing: border-box;
    max-height: 38px!important;
    min-height: 38px!important;
    justify-content: center;
    align-items: center
}

.-searching--result--selected .-remove-custom-post-select-tools {
    display: none
}

.AjaxSearchCenter {
    display: flex;
    align-content: center;
    align-items: center;
    border-bottom: 1px solid var(--diver);
    margin-bottom: 10px;
    padding: 0 10px
}

.-fix-inputs-area .AjaxSearchCenter input[type=text] {
    min-height: 50px;
    border-top: 0!important;
    border-right: 0px!important;
    border-left: 0!important;
    border-image: initial!important;
    border-bottom: 0 solid var(--diver)!important;
    border-radius: 0!important;
    padding: 0 10px!important
}

.AjaxSearchCenter::before {
    content: var(--check-icon);
    position: relative;
    display: block;
    font-size: 25px;
    font-family: "Font Awesome 6 Free";
    font-weight:900;
    margin-left: 4px
}


.alert {
    display: block;
    width: 100%;
    padding: 20px;
    margin-bottom: 20px;
    color: var(--positive);
    background: #31a24c12;
}

.alert.element-alert-danger {
    background: #db113324;
    color: var(--negative);
    border-radius: var(--miniradius);
}
new--necessay {
    display: block;
