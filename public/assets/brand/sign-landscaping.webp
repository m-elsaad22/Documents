2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;}@font-face {font-family: "Plus Jakarta Sans";font-style: normal;font-weight: 800;font-display: swap;src: url(https://www.rukn-eltatawer.com/wp-content/themes/kayan-theme/components/styles/Font/plusjakartasans/LDIoaomQNQcsA88c7O9yZ4KMCoOg4Ko50yyygA.woff2) format("woff2");unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;}@font-face {font-family: "Plus Jakarta Sans";font-style: normal;font-weight: 800;font-display: swap;src: url(https://www.rukn-eltatawer.com/wp-content/themes/kayan-theme/components/styles/Font/plusjakartasans/LDIoaomQNQcsA88c7O9yZ4KMCoOg4Ko40yyygA.woff2) format("woff2");unicode-range: U+0100-02AF, U+0304, U+0308, U+0329, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2113, U+2C60-2C7F, U+A720-A7FF;}@font-face {font-family: "Plus Jakarta Sans";font-style: normal;font-weight: 800;font-display: swap;src: url(https://www.rukn-eltatawer.com/wp-content/themes/kayan-theme/components/styles/Font/plusjakartasans/LDIoaomQNQcsA88c7O9yZ4KMCoOg4Ko20yw.woff2) format("woff2");unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;}/* ╔══════════════════════════════════════════════════════╗
   RUKN v3 HERO — slider_intro_v1.css
   مقدمة الصفحة الرئيسية — التدرج الكحلي + لوحة الخدمات الزجاجية
   (قواعد الريسبونسف الخاصة بالهيرو موجودة في rukn-v3.css)
   ╚══════════════════════════════════════════════════════╝ */
/* ═══════════════ Hero ═══════════════ */
.hero{min-height:100vh;display:flex;align-items:center;padding:120px 0 80px;overflow:hidden;background:var(--grad)}
.hero::before{content:"";position:absolute;inset:0;background:
  radial-gradient(900px 500px at 85% 10%,rgba(79,168,255,.22),transparent 60%),
  radial-gradient(700px 500px at 10% 90%,rgba(41,128,212,.25),transparent 60%)}
.hero-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:54px 54px;mask-image:radial-gradient(circle at 50% 40%,#000,transparent 75%)}
#particles{position:absolute;inset:0;pointer-events:none}
.particle{position:absolute;border-radius:50%;background:rgba(79,168,255,.5);animation:float 12s infinite ease-in-out}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-26px)}}

.hero .wrap{position:relative;z-index:2;display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center}
.hero-copy h1{color:#fff}
.hero-copy h1 em{font-style:normal;background:linear-gradient(120deg,var(--aqua),var(--gold));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.hero-copy .sub{color:rgba(255,255,255,.86);font-size:clamp(16px,1.4vw,20px);margin:22px 0 28px;max-width:620px}
.hero-ctas{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:30px}
.hero-proof{display:flex;flex-wrap:wrap;gap:10px}
.chip{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.18);color:#fff;font-size:14px;font-weight:600;padding:9px 14px;border-radius:999px;backdrop-filter:blur(6px)}
.chip i{color:var(--aqua)}
.chip .star{color:var(--gold)}

/* Hero dashboard */
.dash{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.20);border-radius:var(--r-l);padding:22px;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:var(--sh-l)}
.dash-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.dash-top .ttl{display:flex;align-items:center;gap:10px;color:#fff;font-family:'Cairo';font-weight:800;font-size:17px}
.dash-top .live{display:inline-flex;align-items:center;gap:7px;color:#bdfff0;font-size:12px;font-weight:700;background:rgba(24,201,106,.18);padding:5px 11px;border-radius:999px}
.dash-top .live b{width:8px;height:8px;border-radius:50%;background:var(--success);box-shadow:0 0 0 0 rgba(24,201,106,.6);animation:pulse 1.8s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(24,201,106,.55)}70%{box-shadow:0 0 0 9px rgba(24,201,106,0)}100%{box-shadow:0 0 0 0 rgba(24,201,106,0)}}
.dash-mini{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.mini{background:rgba(255,255,255,.10);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:12px 10px;text-align:center;transition:.25s;cursor:default}
.mini:hover{transform:translateY(-4px);background:rgba(255,255,255,.18)}
.mini i{font-size:20px;color:var(--aqua);margin-bottom:7px}
.mini span{display:block;color:#fff;font-size:12.5px;font-weight:700}
.dash-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.dstat{background:linear-gradient(135deg,rgba(79,168,255,.18),rgba(41,128,212,.14));border:1px solid rgba(255,255,255,.16);border-radius:14px;padding:14px 8px;text-align:center}
.dstat b{display:block;font-family:'Cairo';font-weight:900;font-size:22px;color:#fff;line-height:1}
.dstat small{color:rgba(255,255,255,.78);font-size:11.5px}
.warranty{display:flex;align-items:center;gap:12px;background:linear-gradient(120deg,var(--gold),var(--gold2));border-radius:14px;padding:13px 16px;color:var(--navy);margin-bottom:12px}
.warranty i{font-size:26px}
.warranty b{font-family:'Cairo';font-weight:900;display:block;font-size:15px}
.warranty small{font-weight:600;opacity:.85}
.dash-trust{display:flex;gap:10px}
.dt{flex:1;display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.08);border-radius:11px;padding:9px 11px;color:#fff;font-size:12px;font-weight:700}
.dt i{color:var(--success)}


/* ═══════════════ WordPress adjustments ═══════════════ */
/* الهيرو بيترندر جوه بنية الودجات القديمة — تصفير الحشوات الموروثة */
.hero{margin:0}
.hero .wrap{width:100%}
/* لو الودجت اتحطت جوه صف داخلي قديم */
.-YC-Widgets-Inner-Row .hero{padding:120px 0 80px}
/* العنوان المتدرج */
.hero-copy h1 em{font-style:normal}
/* الخدمات المصغرة كروابط */
a.mini{color:inherit}
.-after__intro-container {display:block;max-width:650px;position:relative;z-index:1;text-align:start }.-after__intro-container>.-widget-after-intro-h1>c--color {color: var(--uicolor);margin-inline-start:10px;font-weight: 700;}.-defult-intro-title-URL .--in--left--button-title a,.-defult-intro-title-URL .--in--left--button-title:hover a {color:#fff }.container--intro--items {display:flex;justify-content: center;align-items: flex-start;}.-contact-style-bg {position:absolute;height:360px;width:200px;border-radius:220px;opacity:.01 }.-contact-style-4 {left:calc(50% + 200px);transform:translateX(-50%) rotate(45deg);bottom:170px;background:var(--uicolor2) }.-contact-style-3,.-contact-style-bg.-contact-style-1 {transform:rotate(-20deg);background:var(--primary-text) }.-contact-style-3 {left:20px;top:-200px }.-contact-style-bg.-contact-style-1 {right:15px;bottom:-380px }.-contact-style-2 {left:calc(50% - 190px);transform:translatex(-50%) rotate(45deg);background:var(--uicolor2) }.-YC-after__intro_SVG {display:block;min-width:270px;margin-inline-start:40px}.-after__intro-image {min-width: max-content;margin-inline-end: 85px;position: sticky;top: 135px;transition: 180ms;}.-defult-intro-title-URL {display:flex;align-content:center;flex-wrap:wrap;margin: 43px 0 0;align-items:center;justify-content:flex-start }.--in--left--button-title>p {display:flex;flex-direction:column;}.about_lists-style1 {flex:1;position:relative;display:flex;padding: 0 10px;max-width: 350px;min-width: 260px;margin-bottom: 15px;}.about_lists-style1:hover:before {top:0;width:100%;height:100% }.about_lists-style1>h4 {font-size:16px;font-weight:700;line-height:28px;color:var(--primary-text);margin-bottom:5px;transition:.4s ease-in-out;position:relative }.-YourColor-SingleWidget-Section.-YC-WidgetType-after__intro .--in--left--button-title>p>a {font-size: 22px;font-weight: 900;font-family: var(--f-number);letter-spacing: 1px;margin-inline-end: 0px;box-shadow: none !important;padding: 0px;color: var(--secondary